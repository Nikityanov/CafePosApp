<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:CafePos.Presentation.ViewModels;assembly=CafePos.Presentation"
             xmlns:models="clr-namespace:CafePos.Core.Models;assembly=CafePos.Core"
             xmlns:shapes="clr-namespace:Microsoft.Maui.Controls.Shapes;assembly=Microsoft.Maui.Controls"
             x:Class="CafePosApp.Views.CatalogFormsPage"
             x:DataType="vm:CatalogFormViewModel"
             x:Name="FormsPage"
             Title="{Binding Title}"
             Shell.NavBarIsVisible="True">

    <ContentPage.ToolbarItems>
        <!-- A real header, so Cancel is reachable from the top on every form instead of only from
             the bottom of a scrolling page. The form is pushed as a modal, which on Android means the
             system back gesture is the other obvious exit — the page code-behind confirms that one.

             Shell.NavBarIsVisible="True" is stated here rather than left to inheritance, and the
             reason is NOT a regression that was observed: measured against a clean baseline on
             the emulator, this modal renders no toolbar item either way — a Shell modal pushed
             with PushModalAsync draws no nav bar on Android, so «Отмена» above never appeared
             before the nav-bar work and Cancel has always lived in the footer. What the property
             WOULD do if inherited is the real hazard: NavBarIsVisible inherits, this modal is
             pushed from CatalogManagementPage, and that page now sets it False. Pinning it True
             keeps this page independent of the caller's chrome, so the title and the toolbar item
             both come up the moment either is made to render. -->
        <ToolbarItem Text="Отмена" Priority="1" Order="Primary"
                     Command="{Binding CancelCommand}" />
    </ContentPage.ToolbarItems>

    <!-- The footer is NOT a DataTemplate any more. In .NET MAUI 10 no cross-platform control has
         a ContentTemplate: ContentView, ContentPresenter and ContentPage all expose Content but
         not ContentTemplate (only ShellContent, and the WinUI platform types under
         Microsoft.Maui.Controls.Platform, do). So <ContentPresenter ContentTemplate="..."/> —
         which this file used four times, once per form — was markup MAUI cannot parse, and it
         aborted the process at inflation, i.e. the moment the catalogue FAB pushed this page.
         A DataTemplateSelector is not an option either: its only consumer is an ItemsView, and
         standing up a one-item CollectionView inside this page's ScrollView would put a second
         scroller in the same gesture (the exact problem the variant list below avoids).
         The footer is therefore built once in code — BuildFormFooter in the code-behind, the same
         pattern the catalogue action sheet already uses via Controls/ResourceStyles.TryApply —
         and the four empty VerticalStackLayouts below are only the slots it is added to. The
         FormFooterTemplate resource it replaces was reachable from nowhere else and is gone. -->

    <!-- The ScrollView owns the remaining height (the star row below), which is what lets a long
         form scroll a focused field clear of the soft keyboard. -->
    <Grid RowDefinitions="Auto,*">
        <Label Grid.Row="0" Text="{Binding Title}" Style="{StaticResource PageTitle}" Margin="16,12,16,0" />

        <!-- No KeyboardDismissMode: that is an iOS UIScrollView member and no MAUI control has it.
             The Page-level KeyboardAvoidingBehavior that used to complement it was removed from
             MAUI in .NET 9, so neither name exists in 10.0.101 and naming either was a runtime
             abort rather than a build error. DismissKeyboard in the code-behind reproduces the
             intent through Unfocus(), which does exist. -->
        <ScrollView x:Name="FormScroll" Grid.Row="1">
            <VerticalStackLayout Padding="16,8" Spacing="12">

                <!-- ═══ PRODUCT FORM ═══ -->
                <VerticalStackLayout IsVisible="{Binding IsProductForm}" Spacing="10">
                    <Border Style="{StaticResource CardBorder}">
                        <VerticalStackLayout Spacing="8">
                            <Label Text="Основное" Style="{StaticResource SectionTitle}" />
                            <Entry Style="{StaticResource FormField}" Placeholder="Название блюда" Text="{Binding Product.ProductName}" ClearButtonVisibility="WhileEditing" />
                            <Entry Style="{StaticResource FormField}" Placeholder="{Binding Product.PricePlaceholder}" Text="{Binding Product.ProductPriceText}" Keyboard="Numeric"
                                   IsEnabled="{Binding Product.IsPriceEnabled}" />
                            <Label Text="Общая цена не нужна: у каждого варианта своя. Заполните список вариантов ниже."
                                   IsVisible="{Binding Product.HasVariants}" Style="{StaticResource Caption}" />
                            <Picker Style="{StaticResource FormFieldPicker}" Title="Раздел" ItemsSource="{Binding Product.CategoryOptions}"
                                    ItemDisplayBinding="{Binding Name}" SelectedItem="{Binding Product.SelectedCategoryOption}" />
                            <Picker Style="{StaticResource FormFieldPicker}" Title="Группа модификаторов" ItemsSource="{Binding Product.ModifierGroupOptions}"
                                    ItemDisplayBinding="{Binding Name}" SelectedItem="{Binding Product.SelectedModifierGroupOption}" />
                            <Grid ColumnDefinitions="Auto,*" ColumnSpacing="8">
                                <CheckBox IsChecked="{Binding Product.HasVariants}" VerticalOptions="Center" />
                                <Label Grid.Column="1" Text="Есть варианты (размеры / объёмы)" VerticalOptions="Center" />
                            </Grid>
                        </VerticalStackLayout>
                    </Border>

                    <!-- Variants -->
                    <Border Style="{StaticResource CardBorder}" IsVisible="{Binding Product.HasVariants}">
                        <VerticalStackLayout Spacing="6">
                            <Label Text="Варианты" Style="{StaticResource SectionTitle}" />
                            <!-- BindableLayout, not a CollectionView. A CollectionView inside this
                                 page's ScrollView is a second scroller fighting the outer one over the
                                 drag gesture, and the old MaximumHeightRequest="180" was a workaround
                                 for that rather than a sizing contract — it capped the list on a tablet
                                 for no reason. The variant list is short and renders its own empty
                                 state. -->
                            <VerticalStackLayout BindableLayout.ItemsSource="{Binding Product.Variants}" Spacing="2">
                                <BindableLayout.ItemTemplate>
                                    <DataTemplate x:DataType="models:ProductVariant">
                                        <Grid ColumnDefinitions="*,Auto,Auto" ColumnSpacing="8" Padding="0,2">
                                            <Label Text="{Binding Name}" VerticalOptions="Center" />
                                            <!-- Whole units here, as before, but through the currency
                                                 converter so the sign follows the setting. The
                                                 placeholder above is a fixed "Цена, ₽" and needs the
                                                 same treatment; see CatalogFormsPage.xaml.cs. -->
                                            <Label Grid.Column="1" Text="{Binding Price, Converter={StaticResource MoneyText}, ConverterParameter=F0}"
                                                   VerticalOptions="Center" Style="{StaticResource Caption}" />
                                            <Button Grid.Column="2" Text="Убрать" Style="{StaticResource RowActionDanger}"
                                                    SemanticProperties.Description="Убрать вариант"
                                                    Command="{Binding Source={x:Reference FormsPage}, Path=BindingContext.Product.RemoveVariantCommand}"
                                                    CommandParameter="{Binding .}" />
                                        </Grid>
                                    </DataTemplate>
                                </BindableLayout.ItemTemplate>
                            </VerticalStackLayout>
                            <Label Text="Вариантов пока нет." Style="{StaticResource EmptyLabel}"
                                   IsVisible="{Binding Product.HasVariantsList}" />
                            <Grid ColumnDefinitions="*,100,Auto" ColumnSpacing="6">
                                <Entry Style="{StaticResource FormField}" Placeholder="Название (М/С/Б)" Text="{Binding Product.NewVariantName}" />
                                <Entry Style="{StaticResource FormField}" Grid.Column="1" Placeholder="Цена" Text="{Binding Product.NewVariantPriceText}" Keyboard="Numeric" />
                                <Button Grid.Column="2" Text="+" WidthRequest="48" HeightRequest="48" MinimumWidthRequest="48" MinimumHeightRequest="48" FontSize="18"
                                        SemanticProperties.Description="Добавить вариант"
                                        Command="{Binding Product.AddVariantCommand}" />
                            </Grid>
                        </VerticalStackLayout>
                    </Border>

                    <!-- Details -->
                    <Border Style="{StaticResource CardBorder}">
                        <VerticalStackLayout Spacing="8">
                            <Label Text="Детали" Style="{StaticResource SectionTitle}" />
                            <Grid ColumnDefinitions="Auto,*" ColumnSpacing="8">
                                <!-- The mark is a SIBLING of the button, not its content: a MAUI
                                     Button is text-and-image only. It has no content property at
                                     all in 10.0.101 (no Content, and no ControlTemplate either —
                                     that belongs to TemplatedView), so <Button.Content> was the
                                     first thing the product form hit and aborted the app. Same
                                     arrangement as the row overflow dots in
                                     Controls/CatalogRow.xaml: the Grid carries the 44dp touch
                                     target, the button fills it and takes the tap, and the Path
                                     is input-transparent so it cannot swallow it. A vector mark
                                     rather than an emoji, because the implicit Button style sets
                                     FontFamily=OpenSansRegular, which has no emoji glyphs — the
                                     character fell through to a platform-dependent fallback font. -->
                                <Grid WidthRequest="44" HeightRequest="44" VerticalOptions="Center">
                                    <Button Style="{StaticResource SecondaryButton}"
                                            HorizontalOptions="Fill" VerticalOptions="Fill" Padding="0"
                                            SemanticProperties.Description="Выбрать фото товара"
                                            Command="{Binding Product.PickPhotoCommand}" />
                                    <!-- The mark goes ON TOP of the button, not under it. In a Grid the
                                         later sibling paints later, and SecondaryButton has an opaque
                                         Gray300 fill — declared first, the button covered the mark and
                                         the control rendered as a blank grey square. InputTransparent
                                         is what keeps the mark from swallowing the button's tap. -->
                                    <shapes:Path Aspect="Uniform" WidthRequest="20" HeightRequest="20"
                                                 HorizontalOptions="Center" VerticalOptions="Center"
                                                 InputTransparent="True"
                                                 Stroke="{StaticResource Gray700}" StrokeThickness="2" Fill="Transparent"
                                                 Data="M9,3 L7.17,5 L4,5 C2.9,5 2,5.9 2,7 L2,19 C2,20.1 2.9,21 4,21 L20,21 C21.1,21 22,20.1 22,19 L22,7 C22,5.9 21.1,5 20,5 L16.83,5 L15,3 L9,3 Z M12,17 C9.24,17 7,14.76 7,12 C7,9.24 9.24,7 12,7 C14.76,7 17,9.24 17,12 C17,14.76 14.76,17 12,17 Z M12,9 C10.34,9 9,10.34 9,12 C9,13.66 10.34,15 12,15 C13.66,15 15,13.66 15,12 C15,10.34 13.66,9 12,9 Z" />
                                </Grid>
                                <Label Grid.Column="1" VerticalOptions="Center" LineBreakMode="TailTruncation"
                                       Style="{StaticResource Caption}" Text="{Binding Product.PhotoPath, StringFormat='Фото: {0}', TargetNullValue='Фото не выбрано', FallbackValue='Фото не выбрано'}" />
                            </Grid>
                            <Entry Style="{StaticResource FormField}" Placeholder="Аллергены (через запятую)" Text="{Binding Product.Allergens}" />
                            <Entry Style="{StaticResource FormField}" Placeholder="Теги (через запятую)" Text="{Binding Product.Tags}" />
                            <Grid ColumnDefinitions="*,*" ColumnSpacing="8">
                                <Picker Style="{StaticResource FormFieldPicker}" Title="Доступен с" ItemsSource="{Binding Product.Hours}" SelectedIndex="{Binding Product.FromHourIndex}" />
                                <Picker Style="{StaticResource FormFieldPicker}" Grid.Column="1" Title="Доступен до" ItemsSource="{Binding Product.Hours}" SelectedIndex="{Binding Product.ToHourIndex}" />
                            </Grid>
                        </VerticalStackLayout>
                    </Border>

                    <!-- Recipe / cost / price history (saved products only) -->
                    <Border Style="{StaticResource CardBorder}" IsVisible="{Binding Product.IsEditing}">
                        <VerticalStackLayout Spacing="6">
                            <Label Text="Рецепт и себестоимость" Style="{StaticResource SectionTitle}" />
                            <Label Text="{Binding Product.CostPriceText}" Style="{StaticResource Caption}" />
                            <Label Text="{Binding Product.MarginText}" Style="{StaticResource Caption}" />
                            <VerticalStackLayout BindableLayout.ItemsSource="{Binding Product.Recipes}" Spacing="2">
                                <BindableLayout.ItemTemplate>
                                    <DataTemplate x:DataType="models:RecipeItem">
                                        <Grid ColumnDefinitions="*,Auto,Auto" ColumnSpacing="8" Padding="0,2">
                                            <Label Text="{Binding Ingredient.Name}" VerticalOptions="Center" />
                                            <Label Grid.Column="1" VerticalOptions="Center" Style="{StaticResource Caption}"
                                                   Text="{Binding QuantityText}" />
                                            <Button Grid.Column="2" Text="Убрать" Style="{StaticResource RowActionDanger}"
                                                    SemanticProperties.Description="Убрать ингредиент из рецепта"
                                                    Command="{Binding Source={x:Reference FormsPage}, Path=BindingContext.Product.DeleteRecipeItemCommand}"
                                                    CommandParameter="{Binding .}" />
                                        </Grid>
                                    </DataTemplate>
                                </BindableLayout.ItemTemplate>
                            </VerticalStackLayout>
                            <Label Text="Рецепт не задан." Style="{StaticResource EmptyLabel}"
                                   IsVisible="{Binding Product.HasRecipes}" />
                            <Grid ColumnDefinitions="*,100,Auto" ColumnSpacing="6">
                                <Picker Style="{StaticResource FormFieldPicker}" Title="Ингредиент" ItemsSource="{Binding Product.Ingredients}"
                                        ItemDisplayBinding="{Binding Name}" SelectedItem="{Binding Product.SelectedRecipeIngredient}" />
                                <Entry Style="{StaticResource FormField}" Grid.Column="1" Placeholder="Кол-во" Text="{Binding Product.RecipeQuantityText}" Keyboard="Numeric" />
                                <Button Grid.Column="2" Text="+" WidthRequest="48" HeightRequest="48" MinimumWidthRequest="48" MinimumHeightRequest="48" FontSize="18"
                                        SemanticProperties.Description="Добавить ингредиент в рецепт"
                                        Command="{Binding Product.AddRecipeItemCommand}" />
                            </Grid>

                            <Label Text="История изменения цены" Style="{StaticResource Caption}" Margin="0,6,0,0" />
                            <!-- The old list had no EmptyView, so a freshly saved product showed a
                                 labelled 110dp blank box. -->
                            <VerticalStackLayout BindableLayout.ItemsSource="{Binding Product.PriceHistory}" Spacing="2">
                                <BindableLayout.ItemTemplate>
                                    <DataTemplate x:DataType="models:PriceHistoryEntry">
                                        <Label Style="{StaticResource Caption}" Text="{Binding ChangeText}" />
                                    </DataTemplate>
                                </BindableLayout.ItemTemplate>
                            </VerticalStackLayout>
                            <Label Text="Изменений цены ещё не было." Style="{StaticResource EmptyLabel}"
                                   IsVisible="{Binding Product.HasPriceHistory}" />
                        </VerticalStackLayout>
                    </Border>

                    <!-- Footer slot. Filled in the code-behind by BuildFormFooter, bound to the
                         product form's own Save/Cancel/ValidationMessage. -->
                    <VerticalStackLayout x:Name="ProductFooterHost" />
                </VerticalStackLayout>

                <!-- ═══ CATEGORY FORM ═══ -->
                <VerticalStackLayout IsVisible="{Binding IsCategoryForm}" Spacing="10">
                    <Border Style="{StaticResource CardBorder}">
                        <VerticalStackLayout Spacing="8">
                            <Entry Style="{StaticResource FormField}" Placeholder="Название раздела" Text="{Binding Category.Name}" ClearButtonVisibility="WhileEditing" />
                        </VerticalStackLayout>
                    </Border>
                    <VerticalStackLayout x:Name="CategoryFooterHost" />
                </VerticalStackLayout>

                <!-- ═══ MODIFIER GROUP FORM ═══ -->
                <VerticalStackLayout IsVisible="{Binding IsModifierForm}" Spacing="10">
                    <Border Style="{StaticResource CardBorder}">
                        <VerticalStackLayout Spacing="8">
                            <Entry Style="{StaticResource FormField}" Placeholder="Название группы (например, «Сиропы»)" Text="{Binding Modifier.Name}" ClearButtonVisibility="WhileEditing" />
                            <Label Text="Варианты — каждый с новой строки:" Style="{StaticResource Caption}" />
                            <!-- AutoSize="TextChanges" fought the sibling HeightRequest="140": the
                                 editor grew with every keystroke and, inside the page ScrollView, grew
                                 without bound. A fixed height with a scrollable editor is the sane
                                 contract for a text box.
                                 The placeholder no longer hardcodes a line break (&#x0a;), which is
                                 not rendered on every platform. -->
                            <Editor Style="{StaticResource FormFieldEditor}" Text="{Binding Modifier.OptionsText}" HeightRequest="160"
                                    Placeholder="По одному варианту в строке, например:&#10;Карамель&#10;Ваниль" />
                        </VerticalStackLayout>
                    </Border>
                    <VerticalStackLayout x:Name="ModifierFooterHost" />
                </VerticalStackLayout>

                <!-- ═══ INGREDIENT FORM ═══ -->
                <VerticalStackLayout IsVisible="{Binding IsIngredientForm}" Spacing="10">
                    <Border Style="{StaticResource CardBorder}">
                        <VerticalStackLayout Spacing="8">
                            <Entry Style="{StaticResource FormField}" Placeholder="Название ингредиента" Text="{Binding Ingredient.Name}" ClearButtonVisibility="WhileEditing" />
                            <Entry Style="{StaticResource FormField}" Placeholder="Единица измерения (г, мл, шт)" Text="{Binding Ingredient.Unit}" />
                            <Entry Style="{StaticResource FormField}" Placeholder="{Binding Ingredient.CostPlaceholder}" Text="{Binding Ingredient.CostText}" Keyboard="Numeric" />
                            <Entry Style="{StaticResource FormField}" Placeholder="Остаток на складе" Text="{Binding Ingredient.StockText}" Keyboard="Numeric" />
                            <Entry Style="{StaticResource FormField}" Placeholder="Минимальный запас (для предупреждений)" Text="{Binding Ingredient.MinStockText}" Keyboard="Numeric" />
                            <Entry Style="{StaticResource FormField}" Placeholder="Поставщик (необязательно)" Text="{Binding Ingredient.Supplier}" />
                        </VerticalStackLayout>
                    </Border>
                    <VerticalStackLayout x:Name="IngredientFooterHost" />
                </VerticalStackLayout>

                <!-- ═══ COMBO FORM ═══ -->
                <!-- A combo has its OWN PRICE, typed here by the owner. The à la carte sum of the
                     slots is shown beside it as a read-only reference — it is what the discount is
                     measured against, never a second price. The discount line under the field is
                     the point: the owner decides the price and sees immediately what it means as
                     a saving or a surcharge, computed from ComboPricing.DiscountPercent/Compare.

                     The price is required: SaveComboAsync refuses a bundle at zero or less, and
                     the form says so where the mistake is rather than at the button. -->
                <VerticalStackLayout IsVisible="{Binding IsComboForm}" Spacing="10">
                    <Border Style="{StaticResource CardBorder}">
                        <VerticalStackLayout Spacing="8">
                            <Label Text="Основное" Style="{StaticResource SectionTitle}" />
                            <Entry Style="{StaticResource FormField}" Placeholder="Название комбо"
                                   Text="{Binding Combo.ComboName}" ClearButtonVisibility="WhileEditing" />

                            <!-- The price field. Required, numeric, and the owner's decision — the
                                 domain refuses a bundle at zero or less. The placeholder names the
                                 currency's unit so the field is self-describing. -->
                            <Entry Style="{StaticResource FormField}" Placeholder="Цена комбо"
                                   Text="{Binding Combo.ComboPriceText}" Keyboard="Numeric"
                                   SemanticProperties.Description="Цена комбо — сколько касса берёт за один набор" />

                            <!-- The à la carte reference: what the same dishes would cost separately.
                                 Read-only, recomputed on every slot change. This is the figure the
                                 discount is measured against — never a second price. -->
                            <Border Style="{StaticResource TagInfo}" StrokeShape="RoundRectangle 8" Padding="10,8">
                                <VerticalStackLayout Spacing="2">
                                    <Label Text="{Binding Combo.ReferenceText}" FontSize="20" FontAttributes="Bold"
                                           SemanticProperties.Description="{Binding Combo.ReferenceText, StringFormat='По отдельности: {0}. Это сумма компонентов, а не цена комбо.'}" />
                                    <Label Text="{Binding Combo.SlotCountText}" Style="{StaticResource Caption}" />
                                </VerticalStackLayout>
                            </Border>

                            <!-- The discount, in words. Empty when there is nothing to compare
                                 against — a bundle whose parts cost nothing has no percentage, and
                                 «0%» would be a false statement about a bundle the customer pays
                                 for. The hint states why the percentage is or is not shown. -->
                            <Label Text="{Binding Combo.DiscountText}" Style="{StaticResource Caption}"
                                   FontAttributes="Bold" LineBreakMode="WordWrap"
                                   IsVisible="{Binding Combo.DiscountText, Converter={StaticResource IsPresent}}" />
                            <!-- Hidden when empty. DiscountHint returns string.Empty for the
                                 ordinary case now (a bundle priced below its parts is what a bundle
                                 is), and a Label bound to an empty string still occupies its line
                                 in the stack — so without this the cut would buy nothing. -->
                            <Label Text="{Binding Combo.DiscountHint}" Style="{StaticResource Caption}"
                                   LineBreakMode="WordWrap"
                                   IsVisible="{Binding Combo.DiscountHint, Converter={StaticResource IsPresent}}" />
                        </VerticalStackLayout>
                    </Border>

                    <Border Style="{StaticResource CardBorder}">
                        <VerticalStackLayout Spacing="6">
                            <Label Text="Состав" Style="{StaticResource SectionTitle}" />
                            <!-- Stated before the first slot is added, not in the save's failure
                                 message. ComboService.SaveComboAsync REPLACES the whole slot set —
                                 that is the only safe shape, because a partial write silently
                                 destroys the children it did not mention — so removing a slot here
                                 really does delete it, and an operator who does not know that will
                                 remove it twice and then trust the screen even less. -->
                            <Label Text="{Binding Combo.ReplacementNote}" Style="{StaticResource Caption}"
                                   LineBreakMode="WordWrap" />

                            <!-- BindableLayout for the same reason as the variant and recipe lists: a
                                 CollectionView inside this page's ScrollView is a second scroller
                                 fighting the outer one over the drag gesture. -->
                            <VerticalStackLayout BindableLayout.ItemsSource="{Binding Combo.Components}" Spacing="6">
                                <BindableLayout.ItemTemplate>
                                    <DataTemplate x:DataType="vm:ComboSlotRow">
                                        <!-- CardBorderCompact, not a bare Grid: one slot is several
                                             fields plus a destructive action, and a set of loose
                                             entries on the page fill would read as a paragraph that
                                             happens to contain pickers. -->
                                        <!-- ═══ ONE SLOT LOOKS LIKE ONE CART LINE ═══
                                             The owner's rule: a combo is assembled the way an order is
                                             assembled, with the single difference that the price typed at the
                                             top is the price of the whole bundle.

                                             TWO LINES, not three, and the first attempt was three. It had a
                                             dish picker on one row, a stepper on the next and a full-width
                                             destructive button below that — which replaced two text fields
                                             with two button rows and came out TALLER than what it replaced.
                                             Height is what costs space on a form, so the slot is now two
                                             rows: the dish and what it contributes stacked on the left, the
                                             cart's − / count / + on the right. The remove control moves to a
                                             compact × on that same row, because three full-width red bars
                                             stacked down a bundle read as alarm rather than as three
                                             ordinary rows.

                                             WHAT CAME OUT, each on the owner's instruction rather than on a
                                             judgement of mine:
                                               · the quantity Entry and its "1 × 220,00 ₿ = 220,00 ₿" caption,
                                                 which the cart's stepper replaces and which cannot be typed
                                                 into nonsense;
                                               · the separate "Цена блюда" row — the same figure the line
                                                 contribution now carries, so it was printed twice;
                                               · the price-mode picker, the own-price field and the substitute
                                                 picker. Their values are still WRITTEN on save (see
                                                 ComboFormViewModel.BuildSlots), because the save replaces the
                                                 whole component set and a form that stopped displaying them
                                                 would erase them.

                                             The dish stays a Picker because it is how a slot is CHANGED once
                                             it exists, not only added: behind a summary there would be no way
                                             to swap a dish without deleting the slot and rebuilding it, and
                                             deleting a slot really does delete it. -->
                                        <Border Style="{StaticResource CardBorderCompact}" Padding="10,8">
                                            <!-- A BORDER TAKES EXACTLY ONE CHILD, and this one started as two: the
                                                 grid and the warning label below it. Only the LAST child is
                                                 rendered, so the grid vanished and every slot came out as an
                                                 empty card — three of them, with the components still counted
                                                 as present. A single VerticalStackLayout is what the
                                                 original slot had, and putting it back is the whole fix. It
                                                 reads like a platform quirk that cannot bite again, but it
                                                 can: the same trap is one extra sibling away in any card. -->
                                            <VerticalStackLayout Spacing="4">
                                            <!-- THE DISH GETS A LINE OF ITS OWN — a bug fix, not a layout
                                                 preference. Sharing one row with the stepper, the Android
                                                 Spinner that backs a MAUI Picker is measured WIDER THAN ITS
                                                 STAR COLUMN, and its native touch target spilled across the +
                                                 beside it. The + rendered in exactly the right place and never
                                                 once answered a press; the × survived only because it sits one
                                                 column further from the spill, which is what made this look
                                                 like a broken command rather than a stolen touch.

                                                 Proven by removal, not by argument: with the Picker deleted the
                                                 + went live at once — 1 → 2, «1 × 160.00 ₿» → «2 × 160.00 ₿»,
                                                 «По отдельноcти» 660 → 820, скидка 24.24% → 39.02%.

                                                 Given the whole card width there is nothing to spill into, the
                                                 row is no taller than the two lines it already was, and long
                                                 dish names finally have somewhere to go. -->
                                            <Picker Style="{StaticResource FormFieldPicker}" Title="Блюдо"
                                                    ItemsSource="{Binding ProductOptions}"
                                                    ItemDisplayBinding="{Binding Name}"
                                                    SelectedItem="{Binding SelectedProductOption}"
                                                    SemanticProperties.Description="Блюдо в составе комбо" />

                                            <Grid ColumnDefinitions="*,Auto,Auto" ColumnSpacing="8">
                                                <!-- What the slot adds to «по отдельноcти», beside the control
                                                     that changes it: the operator is checking the TOTAL, and
                                                     this is the one figure that lets them check it without
                                                     multiplying out loud. -->
                                                <Label Text="{Binding LineTotalText}" FontSize="12"
                                                       Style="{StaticResource SecondaryLabel}"
                                                       VerticalTextAlignment="Center"
                                                       LineBreakMode="TailTruncation"
                                                       SemanticProperties.Description="{Binding LineTotalText, StringFormat='Вклад в состав: {0}'}" />

                                                <!-- THE CART'S STEPPER, AT THE CART'S SIZES. StepperButton and
                                                     not a new style, so a bundle is assembled with the same
                                                     control under the same thumb as an order is — which is the
                                                     point of the change.

                                                     THE COMMANDS COME FROM THE FORM, with the row as
                                                     CommandParameter, which is the cart's arrangement and
                                                     not an accident. Bound straight to a RelayCommand on
                                                     the row, these two buttons rendered in exactly the
                                                     right place and did nothing when pressed — same
                                                     style, same coordinates, and the × beside them,
                                                     which resolves through the page, fired every time.
                                                     The cart's own stepper, wired this way, was verified
                                                     live on the device. One mechanism for the same
                                                     gesture across the app, and it is the one that works.

                                                     No CanExecute on either: − at one unit is refused by
                                                     StepQuantity, the same rule every caller obeys, so the
                                                     − is left looking as it does in the cart rather than
                                                     inventing a second way of saying "already at one". -->
                                                <Grid Grid.Column="1" ColumnDefinitions="40,40,40" ColumnSpacing="0"
                                                      VerticalOptions="Center">
                                                    <Button Text="−" Style="{StaticResource StepperButton}"
                                                            Command="{Binding Source={x:Reference FormsPage}, Path=BindingContext.Combo.StepComponentQuantityDownCommand}"
                                                            CommandParameter="{Binding .}"
                                                            SemanticProperties.Description="Убрать одну штуку" />
                                                    <Label Grid.Column="1" Text="{Binding QuantityPerUnit}"
                                                           FontSize="19" FontAttributes="Bold" WidthRequest="40"
                                                           HorizontalTextAlignment="Center" VerticalTextAlignment="Center"
                                                           SemanticProperties.Description="Сколько этого блюда в комбо" />
                                                    <Button Grid.Column="2" Text="+" Style="{StaticResource StepperButton}"
                                                            Command="{Binding Source={x:Reference FormsPage}, Path=BindingContext.Combo.StepComponentQuantityCommand}"
                                                            CommandParameter="{Binding .}"
                                                            SemanticProperties.Description="Добавить одну штуку" />
                                                </Grid>

                                                <!-- A compact × rather than a full-width bar. The store still
                                                     says what it does — the label, the accessible
                                                     description and the note above the list all state that
                                                     removal DELETES the component — and the row stops being
                                                     three rows tall. 48dp square so it is not a small target
                                                     for the sake of a tidy layout. -->
                                                <Button Grid.Column="2" Text="×" Style="{StaticResource RowActionDanger}"
                                                        WidthRequest="48" HeightRequest="48" MinimumWidthRequest="48" MinimumHeightRequest="48"
                                                        FontSize="22" Padding="0"
                                                        Command="{Binding Source={x:Reference FormsPage}, Path=BindingContext.Combo.RemoveSlotCommand}"
                                                        CommandParameter="{Binding .}"
                                                        SemanticProperties.Description="Убрать этот компонент из состава комбо. При сохранении он будет удалён." />
                                            </Grid>

                                            <!-- Wording, not a red border: the row is still editable and the
                                                 problem is a sentence the operator can act on. Kept because the
                                                 stepper cannot produce an invalid quantity, but a slot can
                                                 still be EMPTY. -->
                                            <Label Text="{Binding WarningText}" Style="{StaticResource Caption}"
                                                   LineBreakMode="WordWrap"
                                                   TextColor="{AppThemeBinding Light={StaticResource WarningText}, Dark={StaticResource WarningDark}}"
                                                   IsVisible="{Binding WarningText, Converter={StaticResource IsPresent}}" />
                                            </VerticalStackLayout>
                                        </Border>
                                    </DataTemplate>
                                </BindableLayout.ItemTemplate>
                            </VerticalStackLayout>

                            <!-- BindableLayout has no EmptyView, hence the label. It says the
                                 CONSEQUENCE rather than "the list is empty": a bundle with no slots
                                 cannot be saved, and the domain refuses one. -->
                            <Label Text="Компонентов пока нет. Добавьте хотя бы один — без них комбо сохранить нельзя."
                                   Style="{StaticResource EmptyLabel}" LineBreakMode="WordWrap"
                                   IsVisible="{Binding Combo.HasNoComponents}" />

                            <!-- The add row mirrors the recipe row above it: dish, quantity, "+".
                                 A bundle with no slots cannot be saved, so the add row is the only
                                 way forward and it is the last thing on the form for that reason. -->
                            <Grid ColumnDefinitions="*,100,Auto" ColumnSpacing="6">
                                <Picker Style="{StaticResource FormFieldPicker}" Title="Блюдо для компонента"
                                        ItemsSource="{Binding Combo.ProductOptions}"
                                        ItemDisplayBinding="{Binding Name}"
                                        SelectedItem="{Binding Combo.NewSlotProductOption}" />
                                <Entry Style="{StaticResource FormField}" Grid.Column="1" Placeholder="Кол-во"
                                       Text="{Binding Combo.NewSlotQuantityText}" Keyboard="Numeric" />
                                <Button Grid.Column="2" Text="+" WidthRequest="48" HeightRequest="48" MinimumWidthRequest="48" MinimumHeightRequest="48" FontSize="18"
                                        SemanticProperties.Description="Добавить компонент в комбо"
                                        Command="{Binding Combo.AddSlotCommand}" />
                            </Grid>
                        </VerticalStackLayout>
                    </Border>

                    <!-- Footer slot. Same shape as the four above: the Save / Отмена pair and the
                         validation message, built in the code-behind by BuildFormFooter. -->
                    <VerticalStackLayout x:Name="ComboFooterHost" />
                </VerticalStackLayout>

            </VerticalStackLayout>
        </ScrollView>
    </Grid>
</ContentPage>
