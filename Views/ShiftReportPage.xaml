<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui" xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml" xmlns:vm="clr-namespace:CafePosApp.ViewModels" x:Class="CafePosApp.Views.ShiftReportPage" x:DataType="vm:ShiftReportViewModel" Title="Смена">
    <!-- The order history used to sit inside a ScrollView, which made the CollectionView measure
         every completed order up front and killed recycling. The static summary rows stay Auto,
         the list takes the remaining space. -->
    <Grid RowDefinitions="Auto,Auto,Auto,Auto,Auto,*,Auto" Padding="16" RowSpacing="10">
        <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
            <!-- No PageTitle label. The Shell nav bar already reads "Смена", and the page put
                 "Смена / Отчёт" straight under it — the same word twice at two sizes before any
                 content. "Отчёт" adds nothing the report's own section headings do not say. -->
            <Button Grid.Column="1" Text="Обновить" Style="{StaticResource ToolbarButton}" Command="{Binding LoadCommand}" IsEnabled="{Binding IsBusy, Converter={StaticResource InvertedBoolConverter}}" SemanticProperties.Description="Обновить отчёт" />
        </Grid>
        <Label Grid.Row="1" Text="{Binding Message}" IsVisible="{Binding HasMessage}" TextColor="{StaticResource Danger}" LineBreakMode="WordWrap" />
            <Border Grid.Row="2" Style="{StaticResource CardBorder}">
                <VerticalStackLayout Spacing="6">
                    <Label Text="{Binding Revenue, StringFormat='Выручка: {0:F2} ₽'}" FontAttributes="Bold" />
                    <Label Text="{Binding ClosedOrdersCount, StringFormat='Чеков: {0}'}" />
                    <Label Text="{Binding CancelledOrdersCount, StringFormat='Отменено: {0}'}" />
                    <Label Text="{Binding AverageCheck, StringFormat='Средний чек: {0:F2} ₽'}" />
                </VerticalStackLayout>
            </Border>
            <Button Grid.Row="3" Text="Анализировать смену" Command="{Binding OpenAnalyticsCommand}" />
            <Label Grid.Row="4" Text="История выполненных заказов" Style="{StaticResource SectionTitle}" />
            <CollectionView Grid.Row="5" ItemsSource="{Binding CompletedOrders}" SelectionMode="None">
                <CollectionView.EmptyView>
                    <Label Text="Выполненных заказов пока нет." Style="{StaticResource EmptyLabel}" />
                </CollectionView.EmptyView>
                <CollectionView.ItemTemplate>
                    <DataTemplate x:DataType="vm:OrderRowViewModel">
                        <Border Style="{StaticResource CardBorder}" Margin="0,0,0,4">
                            <VerticalStackLayout Spacing="4">
                                <Grid ColumnDefinitions="*,Auto">
                                    <Label Text="{Binding OrderTitle}" FontAttributes="Bold" />
                                    <!-- CreatedAtText, not StringFormat on Model.CreatedAt. The
                                         raw DateTimeOffset is UTC (migration 3), and StringFormat
                                         renders it without a zone conversion — so the same order
                                         read 18:46 on the orders board and 16:46 in this history
                                         on a UTC+2 device. The binding was valid, so no build
                                         caught it; OrderRowViewModel.CreatedAtText already does
                                         the ToLocalTime() the orders page relies on. -->
                                    <Label Grid.Column="1" Text="{Binding CreatedAtText}" Style="{StaticResource SecondaryLabel}" />
                                </Grid>
                                <VerticalStackLayout BindableLayout.ItemsSource="{Binding ItemLines}" Spacing="3">
                                    <BindableLayout.ItemTemplate>
                                        <DataTemplate x:DataType="vm:OrderItemLine">
                                            <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8" Padding="0,0,2,0">
                                                <Label Text="{Binding Name}" LineBreakMode="WordWrap" />
                                                <Label Grid.Column="1" Text="{Binding Quantity, StringFormat='× {0}'}" FontAttributes="Bold" VerticalTextAlignment="Start" />
                                            </Grid>
                                        </DataTemplate>
                                    </BindableLayout.ItemTemplate>
                                </VerticalStackLayout>
                                <Label Text="{Binding TotalPrice, StringFormat='Итого: {0:F2} ₽'}" FontAttributes="Bold" />
                            </VerticalStackLayout>
                        </Border>
                    </DataTemplate>
                </CollectionView.ItemTemplate>
            </CollectionView>
            <Button Grid.Row="6" Text="Закрыть смену и открыть новую" Style="{StaticResource DangerButton}" Command="{Binding CloseShiftCommand}" />
    </Grid>
</ContentPage>
