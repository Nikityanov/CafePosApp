<toolkit:Popup x:TypeArguments="x:String"
             xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:toolkit="http://schemas.microsoft.com/dotnet/2022/maui/toolkit"
             x:Class="CafePosApp.Views.CatalogActionSheetPopup"
             VerticalOptions="End"
             HorizontalOptions="Fill"
             Margin="0"
             BackgroundColor="{AppThemeBinding Light={StaticResource Surface}, Dark={StaticResource SurfaceDark}}">
    <ScrollView x:Name="SheetScroll">
        <VerticalStackLayout Padding="16,8" Spacing="0">
            <BoxView Style="{StaticResource BottomSheetHandle}" />
            <!-- The sheet's heading: the item name is what the row was tapped for, so it reads as a
                 real title, not an eyebrow — a muted 12pt eyebrow made the sheet feel unlabelled. -->
            <Label x:Name="TitleLabel" FontSize="17" FontAttributes="Bold"
                   TextColor="{AppThemeBinding Light={StaticResource Gray900}, Dark={StaticResource Gray100}}"
                   LineBreakMode="TailTruncation" Margin="0,10,0,12" />
            <VerticalStackLayout x:Name="OptionsLayout" Spacing="8" />
        </VerticalStackLayout>
    </ScrollView>
</toolkit:Popup>
