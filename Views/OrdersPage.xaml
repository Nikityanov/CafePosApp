<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui" xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml" xmlns:vm="clr-namespace:CafePosApp.ViewModels" x:Class="CafePosApp.Views.OrdersPage" x:DataType="vm:OrdersViewModel" Title="Заказы">
    <ContentPage.Resources>
        <DataTemplate x:Key="OrderCardTemplate" x:DataType="vm:OrderRowViewModel">
            <Border Style="{StaticResource CardBorder}" Stroke="{Binding StatusColor}" StrokeThickness="2" Margin="0,0,0,8">
                <VerticalStackLayout Spacing="7">
                    <Grid ColumnDefinitions="*,Auto">
                        <VerticalStackLayout Spacing="1">
                            <Label Text="{Binding OrderTitle}" FontSize="18" FontAttributes="Bold" />
                            <Label Text="{Binding CreatedAtText}" Style="{StaticResource SecondaryLabel}" />
                        </VerticalStackLayout>
                        <!-- One rendering of the status, not three. The card carried both
                             StatusText and StatusHint as separate bold lines under a column
                             header that already named the state, so one order said "Готовятся"
                             (header), "Готовится" (chip) and "Заказ готовится" (line) at once.
                             The chip alone is unambiguous in both layouts: the kanban column
                             supplies the plural, the list view has no column. StatusHint is
                             kept as the accessible description so screen readers still get
                             the sentence form. -->
                        <Label Grid.Column="1" Text="{Binding StatusText}" TextColor="{Binding StatusColor}" FontAttributes="Bold" VerticalOptions="Center"
                               SemanticProperties.Description="{Binding StatusHint}" />
                    </Grid>
                    <VerticalStackLayout BindableLayout.ItemsSource="{Binding ItemLines}" Spacing="3">
                        <BindableLayout.ItemTemplate>
                            <DataTemplate x:DataType="vm:OrderItemLine">
                                <!-- Name takes the width it needs and wraps; the quantity is a
                                     right-aligned column, so "× 1" can never be orphaned onto a
                                     line of its own under a long product name. -->
                                <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8" Padding="0,0,2,0">
                                    <Label Text="{Binding Name}" LineBreakMode="WordWrap" />
                                    <Label Grid.Column="1" Text="{Binding Quantity, StringFormat='× {0}'}" FontAttributes="Bold" VerticalTextAlignment="Start" />
                                </Grid>
                            </DataTemplate>
                        </BindableLayout.ItemTemplate>
                    </VerticalStackLayout>
                    <Label Text="{Binding TotalPrice, StringFormat='Итого: {0:F2} ₽'}" FontAttributes="Bold" />
                    <Grid ColumnDefinitions="*,*" ColumnSpacing="6">
                        <!-- "Подробнее" was clipped to "Подробн": Padding="8,6" plus the card
                             padding left the label less room than the word needs. Both buttons
                             are 48dp now, matching the 48dp minimum the product rules set and
                             the 48dp steppers on the order details page — they were 44dp. -->
                        <Button Text="Подробнее" Padding="8,6" MinimumHeightRequest="48" Command="{Binding Source={RelativeSource AncestorType={x:Type ContentPage}}, Path=BindingContext.OpenDetailsCommand}" CommandParameter="{Binding .}" />
                        <Button Grid.Column="1" Text="{Binding NextActionText}" Padding="8,6" MinimumHeightRequest="48" Command="{Binding Source={RelativeSource AncestorType={x:Type ContentPage}}, Path=BindingContext.AdvanceStatusCommand}" CommandParameter="{Binding .}" IsEnabled="{Binding CanAdvance}" />
                    </Grid>
                    <!-- DangerButton, matching "Удалить" on the details page and the restore
                         action in Settings. Cancelling an order is destructive and was wearing the
                         same filled primary as "Готов" right above it. -->
                    <Button Text="Отменить заказ" Style="{StaticResource DangerButton}" MinimumHeightRequest="48" Command="{Binding Source={RelativeSource AncestorType={x:Type ContentPage}}, Path=BindingContext.CancelOrderCommand}" CommandParameter="{Binding .}" IsVisible="{Binding CanCancel}" />
                </VerticalStackLayout>
            </Border>
        </DataTemplate>
    </ContentPage.Resources>
    <Grid RowDefinitions="Auto,Auto,*" Padding="12" RowSpacing="8">
        <Grid ColumnDefinitions="*,Auto,Auto" ColumnSpacing="8">
            <!-- No PageTitle label. The Shell nav bar already reads "Заказы", and this page
                 repeated it as "Активные заказы" underneath. Both the kanban and the list show
                 only active orders, so the extra word distinguished nothing. -->
            <Button Grid.Column="1" Text="Обновить" Style="{StaticResource ToolbarButton}" Command="{Binding LoadCommand}" IsEnabled="{Binding IsBusy, Converter={StaticResource InvertedBoolConverter}}" SemanticProperties.Description="Обновить заказы" />
            <Button Grid.Column="2" Text="{Binding ViewModeText}" Command="{Binding ToggleViewCommand}" Padding="12,6" />
        </Grid>
        <Label Grid.Row="1" Text="{Binding Message}" IsVisible="{Binding HasMessage}" TextColor="{StaticResource Danger}" LineBreakMode="WordWrap" />
        <Grid Grid.Row="2">
                <Grid IsVisible="{Binding IsKanban}" RowDefinitions="*" ColumnDefinitions="*,*" ColumnSpacing="8">
                    <VerticalStackLayout Spacing="6">
                        <Label Text="Готовятся" FontAttributes="Bold" TextColor="{StaticResource Warning}" />
                        <CollectionView ItemsSource="{Binding PreparingOrders}" SelectionMode="None" ItemTemplate="{StaticResource OrderCardTemplate}">
                            <CollectionView.EmptyView><Label Text="Нет заказов" Style="{StaticResource EmptyLabel}" /></CollectionView.EmptyView>
                        </CollectionView>
                    </VerticalStackLayout>
                    <VerticalStackLayout Grid.Column="1" Spacing="6">
                        <Label Text="Ждут выдачи" FontAttributes="Bold" TextColor="{StaticResource Success}" />
                        <CollectionView ItemsSource="{Binding ReadyOrders}" SelectionMode="None" ItemTemplate="{StaticResource OrderCardTemplate}">
                            <CollectionView.EmptyView><Label Text="Нет заказов" Style="{StaticResource EmptyLabel}" /></CollectionView.EmptyView>
                        </CollectionView>
                    </VerticalStackLayout>
                </Grid>
                <CollectionView ItemsSource="{Binding ActiveOrders}" SelectionMode="None" IsVisible="{Binding IsList}" ItemTemplate="{StaticResource OrderCardTemplate}">
                    <CollectionView.EmptyView><Label Text="Активных заказов нет." Style="{StaticResource EmptyLabel}" /></CollectionView.EmptyView>
                </CollectionView>
        </Grid>
    </Grid>
</ContentPage>