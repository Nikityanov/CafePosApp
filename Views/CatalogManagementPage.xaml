<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:CafePosApp.ViewModels"
             xmlns:models="clr-namespace:CafePos.Core.Models;assembly=CafePos.Core"
             xmlns:controls="clr-namespace:CafePosApp.Controls"
             xmlns:shapes="clr-namespace:Microsoft.Maui.Controls.Shapes;assembly=Microsoft.Maui.Controls"
             x:Class="CafePosApp.Views.CatalogManagementPage"
             x:DataType="vm:CatalogManagementViewModel"
             x:Name="CatalogPage"
             Title="Каталог">

    <ContentPage.Resources>
        <!-- One chip template for the whole entity switcher, replacing four hand-placed buttons
             that each needed their own keyed style to show the active one. -->
        <DataTemplate x:Key="SectionChipTemplate" x:DataType="vm:CatalogSection">
            <Button Text="{Binding Label}" Style="{StaticResource SectionTab}"
                    Margin="3,3"
                    SemanticProperties.Description="{Binding Label, StringFormat='Открыть раздел: {0}'}"
                    Command="{Binding Source={x:Reference CatalogPage}, Path=BindingContext.SetSectionCommand}"
                    CommandParameter="{Binding Key}">
                <Button.Triggers>
                    <DataTrigger TargetType="Button" Binding="{Binding IsSelected}" Value="True">
                        <Setter Property="BackgroundColor" Value="{StaticResource Primary}" />
                        <Setter Property="TextColor" Value="White" />
                        <Setter Property="BorderWidth" Value="0" />
                    </DataTrigger>
                </Button.Triggers>
            </Button>
        </DataTemplate>

        <!-- The category filter strip. The selection is carried by a filled pill as well as by the
             filter itself taking effect, so the active state is never colour-only: the chosen chip
             is both filled and the only one that narrows the list. -->
        <DataTemplate x:Key="CategoryChipTemplate" x:DataType="vm:CategoryFilterChip">
            <Border Style="{StaticResource FilterChip}" Margin="3,3">
                <Border.Triggers>
                    <DataTrigger TargetType="Border" Binding="{Binding IsSelected}" Value="True">
                        <Setter Property="BackgroundColor" Value="{StaticResource Primary}" />
                        <Setter Property="Stroke" Value="Transparent" />
                    </DataTrigger>
                </Border.Triggers>
                <Label Text="{Binding Name}" Style="{StaticResource FilterChipText}">
                    <Label.Triggers>
                        <DataTrigger TargetType="Label" Binding="{Binding IsSelected}" Value="True">
                            <Setter Property="TextColor" Value="White" />
                        </DataTrigger>
                    </Label.Triggers>
                </Label>
                <Border.GestureRecognizers>
                    <TapGestureRecognizer
                        Command="{Binding Source={x:Reference CatalogPage}, Path=BindingContext.SelectCategoryFilterCommand}"
                        CommandParameter="{Binding .}" />
                </Border.GestureRecognizers>
            </Border>
        </DataTemplate>
    </ContentPage.Resources>

    <!-- ═══ ROOT ═══ -->
    <!-- Three rows: header, notice, content. Each row is a direct child of this Grid with
         HorizontalOptions="Center" and MaximumWidthRequest="1400"; the code-behind sets an
         explicit WidthRequest on all three to min(windowWidth, 1400). An explicit WidthRequest
         bypasses desired-size negotiation — the width is deterministic, not a by-product of
         Auto/*/Fill guessing. The previous approach (a *,Auto,* wrapper with Fill on the
         content) overflowed because Fill takes all offered space while Auto sizes to the
         child's desired size, so the column grew unbounded and pushed the FAB and "Обновить"
         off-screen. The first chip aligns with the left edge of the first card.
         The FAB is a true overlay — a child of the content Grid, VerticalOptions=End /
         HorizontalOptions=End. It floats over the list; the list scrolls underneath it. The FAB
         may overlap the last row — the operator nudges it out from under by scrolling. -->
    <Grid RowDefinitions="Auto,Auto,*">

        <!-- ═══ HEADER: entity switcher ═══ -->
            <!-- Four equal columns gave "Модификаторы" ~81dp on a 360dp phone, less than the word needs
                 at 13pt bold, and SectionTab pinned HeightRequest=36 so the overflow was clipped rather
                 than wrapped. The buttons now size to their text and the strip scrolls: on a 320dp
                 phone it scrolls sideways, on a tablet it fits. No width is hardcoded anywhere, which
                 is the whole point — there was no breakpoint in this file before.
                 MAUI's FlexLayout has no spacing property at all (not Spacing, not ColumnSpacing /
                 RowSpacing — those are Grid's), so the 6dp gutter between chips is a Margin on each
                 chip instead. Naming a spacing property here is not a build error: Debug builds parse
                 this XAML at runtime and only ApplyPropertiesVisitor.SetPropertyValue rejects it, at
                 inflation time.
                 Wrap is NoWrap, not Wrap: a horizontal ScrollView measures its content with an
                 infinite width, so a wrapping FlexLayout can never find a line to break on and its
                 measure pass comes back with a bogus height — the strip reserved ~230dp of blank space
                 below the chips. The old comment claimed the chips "take two rows" on a narrow phone,
                 which a horizontal ScrollView cannot do anyway. The category strip below was already
                 NoWrap for the same reason.

                 «Обновить» is gone from this header too, by the same owner decision as the orders,
                 shift report and analytics pages. The single trailing Auto column existed to hold it,
                 so the header is one wide scrolling strip again and the chips get the whole width —
                 which on a narrow phone is the difference between "Модификаторы" being fully visible
                 and being clipped mid-word. This page does not poll, so the reload is
                 leave-and-re-enter, which OnAppearing already does. -->
        <Grid x:Name="HeaderRow" Grid.Row="0" HorizontalOptions="Center" MaximumWidthRequest="1400" Padding="12,8,12,4">
                <!-- The strip scrolls with the scrollbar visible, because the scrollbar is the affordance:
                 a chip clipped mid-word at the right edge reads as a broken layout rather than as
                 "there is more to the right" — measured on the emulator, "Модификатор" was cut
                 after the "р" against the old «Обновить» button. "Default" is the setting that
                 shows the bar exactly when there is something to scroll to. It is one of exactly
                 three members — Default, Always, Never — and ScrollView exposes no thickness
                 property, so nothing else is available; "Visible" and "Auto" are not members and
                 each of them aborted the process at inflation. -->
            <ScrollView Orientation="Horizontal"
                        HorizontalScrollBarVisibility="Default" VerticalScrollBarVisibility="Never">
                <FlexLayout BindableLayout.ItemsSource="{Binding Sections}"
                            BindableLayout.ItemTemplate="{StaticResource SectionChipTemplate}"
                            Direction="Row" Wrap="NoWrap" AlignItems="Start" />
            </ScrollView>
            </Grid>

            <!-- ═══ NOTICE ═══ -->
            <!-- One label carried both "Скопировано: …" and every error, hard-wired to Danger, so
                 successes rendered in red. Colour now comes from NoticeSeverity and is paired with a
                 leading icon (✓ / !) plus the wording, so the two are never told apart by hue alone.
                 The icon is a Label, not a shapes:Path: Path.Data is a Geometry, and a Binding that
                 hands the XAML loader a string (what the icon converter produces) fails with
                 InvalidCastException. A literal Data="…" attribute would be run through the geometry
                 TypeConverter, but a Binding would not be — and the severity changes at runtime, so it
                 has to be a Binding. Label.Text takes the converter's string directly. -->
        <Grid x:Name="NoticeRow" Grid.Row="1" HorizontalOptions="Center" MaximumWidthRequest="1400" IsVisible="{Binding HasValidationMessage}" ColumnDefinitions="Auto,*" ColumnSpacing="6"
                  Padding="12,4" Margin="0,2,0,2">
                <Label VerticalOptions="Start" FontSize="14" FontAttributes="Bold" Margin="0,0,0,0"
                       TextColor="{Binding NoticeSeverity, Converter={StaticResource NoticeSeverityToColor}}"
                       Text="{Binding NoticeSeverity, Converter={StaticResource NoticeSeverityToIcon}}" />
                <Label Grid.Column="1" Text="{Binding ValidationMessage}" FontSize="12" LineBreakMode="WordWrap"
                       TextColor="{Binding NoticeSeverity, Converter={StaticResource NoticeSeverityToColor}}" />
            </Grid>

            <!-- ═══ CONTENT ═══ -->
            <!-- The four sections sit directly in a Grid, not a ScrollView: a ScrollView would measure
                 every CollectionView to its full content height and defeat recycling. Each list owns the
                 remaining space and virtualises normally.
                 This Grid is a direct child of the root Grid with HorizontalOptions="Fill". Its
                 WidthRequest is set from code to min(windowWidth, 1400), so it fills the capped
                 width deterministically. The FAB is a child of THIS grid, so its HorizontalOptions=End
                 aligns it with the content's right edge, not the window's. The FAB floats over the
                 list — the list scrolls underneath it. The FAB may overlap the last row; the
                 operator nudges it out from under by scrolling. -->
        <Grid x:Name="ContentGrid" Grid.Row="2" HorizontalOptions="Fill">
                <!-- Why there is no pull-to-refresh anywhere on this page, and why there was a
                     «Обновить» button instead: the four sections are four independently-scrolling
                     CollectionViews, not one scrollable surface. A RefreshView whose child is a Grid
                     never fires the pull gesture on Android, and its IsRefreshing was bound OneWay to
                     IsBusy, so the control could write true and nothing wrote the false that stopped
                     the spinner (dotnet/maui#12469). Nesting a ScrollView per list to make the gesture
                     work would defeat the recycling this layout exists for.
                     «Обновить» was the workaround and is now gone by the owner's decision; the reload
                     it performed is OnAppearing's LoadAsync, so navigating away and back is the
                     manual refresh. Nothing on this page polls. -->
                <Grid Padding="12,4">

                    <!-- ── PRODUCTS ── -->
                    <!-- Four rows, and they are all that is left: the count, the category chips, the
                         deleted-products toggle, and the list itself.

                         THREE THINGS CAME OUT OF THIS SECTION and the layout is the record of why.
                           · «Обновить» — the owner's decision, page-wide.
                           · «Выбрать» and the whole bulk-percentage-price mode with it. It was a real
                             feature (multi-select → BulkPriceAdjustAsync), not decoration, and it is
                             gone deliberately. What it bought was a percentage field permanently
                             armed a few millimetres from every product's price; what it cost was a
                             row of chrome and a mode where a tap stopped meaning "open this
                             product". Prices are now changed one product at a time, where the old
                             price is on screen next to the new one.
                           · The SearchBar. The owner considers it unnecessary on a list the
                             catalogue is expected to be small enough to scan, and the category
                             chips below already narrow the list. Removing it is what lets the count
                             and the chips share one row.

                         The count was previously trailing the SearchBar in a two-column Grid;
                         with the search gone it stands alone, so it is a plain label on its own
                         row rather than a leftover column that happens to have one child left in
                         it. It is not colour-only state — it is the count itself in words. -->
                    <Grid RowDefinitions="Auto,Auto,Auto,*" IsVisible="{Binding IsProductsSectionVisible}">
                        <Label Text="{Binding ProductsCountText}" Style="{StaticResource CountLabel}"
                               VerticalOptions="Center" Margin="4,0" />

                        <!-- The category filter. It replaces a fixed 120dp Picker: on Android that opens a
                             blocking modal, swallows the system Back key (dotnet/maui#30430), and cannot show
                             the active filter. A chip strip shows every category at once and wraps. -->
                        <ScrollView Grid.Row="1" Orientation="Horizontal" Margin="0,2,0,0"
                                    HorizontalScrollBarVisibility="Never" VerticalScrollBarVisibility="Never">
                            <FlexLayout BindableLayout.ItemsSource="{Binding CategoryFilters}"
                                        BindableLayout.ItemTemplate="{StaticResource CategoryChipTemplate}"
                                        Direction="Row" Wrap="NoWrap" AlignItems="Center" />
                        </ScrollView>

                        <!-- The whole row toggles the switch. The Switch was scaled to 0.8, which put its
                             touch target under the 48dp minimum, and the adjacent Label was not clickable —
                             so the label read as a label and the switch was barely tappable. MAUI has no
                             IsHitTestVisible: InputTransparent is the equivalent, and it is what lets the
                             row's own tap reach the GestureRecognizer below.

                             Two columns now, because «Выбрать» and «CSV» no longer share it. Both were
                             ToolbarButton — the same chrome as the page's refresh — which put a data-
                             rewriting import two taps from a screen full of prices; the CSV round-trip
                             now lives in Settings beside backup and restore. -->
                        <Grid Grid.Row="2" ColumnDefinitions="Auto,*" ColumnSpacing="8"
                              MinimumHeightRequest="48" Margin="0,2,0,0">
                            <Grid.GestureRecognizers>
                                <TapGestureRecognizer
                                    Command="{Binding Source={x:Reference CatalogPage}, Path=BindingContext.ToggleShowDeletedCommand}" />
                            </Grid.GestureRecognizers>
                            <Switch Grid.Column="0" IsToggled="{Binding ShowDeleted}" VerticalOptions="Center"
                                    InputTransparent="True"
                                    SemanticProperties.Description="Показывать удалённые" />
                            <Label Grid.Column="1" Text="Показывать удалённые" VerticalOptions="Center" Style="{StaticResource Caption}" />
                        </Grid>

                        <!-- SelectionMode is Single, fixed and literal. It used to be bound to
                             IsSelectionMode through BoolToSelectionMode, because selection mode also
                             owned the row tap: Multiple there meant a tick, Single here meant "open
                             the edit form". With the mode gone, the bound value could only ever be
                             Single, so the binding was indirection around a constant. It is spelled out
                             here and the converter is not referenced from any page again. -->
                        <CollectionView x:Name="ProductsList" Grid.Row="3" ItemsSource="{Binding FilteredProducts}"
                                        SelectionMode="Single">
                            <CollectionView.ItemsLayout>
                                <!-- The span is set from code (see CatalogManagementPage.PublishAvailableWidth),
                                     not bound. Two reasons, both measured: ItemsLayout is a BindableObject
                                     outside the visual tree, so a {Binding} on it does not reliably pick up
                                     the page's BindingContext; and .NET MAUI 10 has no other way to state a
                                     column width — ItemWidth was removed from ItemsLayout, and a
                                     WidthRequest or MaxWidthRequest on the card is ignored for sizing
                                     because the platform's ItemsWrapGrid owns the container width. The
                                     span is the only value the grid still honours. -->
                                <GridItemsLayout x:Name="ProductGridLayout" Orientation="Vertical"
                                                 Span="1" HorizontalItemSpacing="4" VerticalItemSpacing="4" />
                            </CollectionView.ItemsLayout>
                            <CollectionView.EmptyView>
                                <Label Text="Товары не найдены." Style="{StaticResource EmptyLabel}" />
                            </CollectionView.EmptyView>
                            <!-- The FAB floats over the list. The list scrolls underneath it; the FAB may
                                 overlap the last row, and the operator nudges it out from under by scrolling. -->
                            <CollectionView.ItemTemplate>
                                <DataTemplate x:DataType="models:Product">
                                    <controls:CatalogRow
                                        LongPressCommand="{Binding Source={x:Reference CatalogPage}, Path=BindingContext.ProductActionsCommand}"
                                        OverflowCommand="{Binding Source={x:Reference CatalogPage}, Path=BindingContext.ProductActionsCommand}"
                                        CommandParameter="{Binding .}"
                                        OverflowDescription="{Binding Name, StringFormat='Действия с товаром {0}'}">
                                        <controls:CatalogRow.RowContent>
                                            <Grid RowDefinitions="Auto,Auto" RowSpacing="4">
                                                <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
                                                    <Label Text="{Binding Name}" Style="{StaticResource RowTitle}" />
                                                    <!-- The price the operator scans most. It used to be
                                                         13pt — the smallest text on the row and the farthest
                                                         from the eye on a wide window. The RowPrice style
                                                         gives it 16pt bold with End alignment, and
                                                         MinimumWidthRequest keeps the column wide enough
                                                         that prices align down the list. -->
                                                    <Label Grid.Column="1"
                                                           Text="{Binding ., Converter={StaticResource ProductPriceText}}"
                                                           Style="{StaticResource RowPrice}"
                                                           MinimumWidthRequest="60"
                                                           TextColor="{AppThemeBinding Light={StaticResource Primary}, Dark={StaticResource PrimaryDark}}" />
                                                </Grid>
                                                <!-- Availability is shown here as a state, not as an
                                                     action — the action itself lives in the overflow menu.
                                                     The pills wrap: a non-wrapping stack clipped long
                                                     stock and cost strings off the right edge. The
                                                     4dp gutter is a Margin on each pill, since
                                                     FlexLayout has no spacing property. -->
                                                <FlexLayout Grid.Row="1" Direction="Row" Wrap="Wrap"
                                                            VerticalOptions="Center">
                                                    <Border Style="{StaticResource TagWarning}" Margin="2,2"
                                                            IsVisible="{Binding IsAvailable, Converter={StaticResource InvertedBoolConverter}}">
                                                        <Label Text="Нет в наличии" Style="{StaticResource TagTextWarning}" />
                                                    </Border>
                                                    <!-- A null category is a first-class state (the form ships an
                                                         explicit "— Без раздела —" row), so the pill is hidden
                                                         rather than rendered as an empty 6dp-padded box. -->
                                                    <Border Style="{StaticResource Tag}" Margin="2,2"
                                                            IsVisible="{Binding Category, Converter={StaticResource IsPresent}}">
                                                        <Label Text="{Binding Category.Name}" Style="{StaticResource TagText}" />
                                                    </Border>
                                                    <Border Style="{StaticResource TagInfo}" Margin="2,2"
                                                            IsVisible="{Binding ModifierGroup, Converter={StaticResource IsPresent}}">
                                                        <Label Text="{Binding ModifierGroup.Name}" Style="{StaticResource TagTextInfo}" />
                                                    </Border>
                                                </FlexLayout>
                                            </Grid>
                                        </controls:CatalogRow.RowContent>
                                    </controls:CatalogRow>
                                </DataTemplate>
                            </CollectionView.ItemTemplate>
                        </CollectionView>
                    </Grid>

                    <!-- ── CATEGORIES ── -->
                    <Grid RowDefinitions="Auto,*" IsVisible="{Binding IsCategoriesSectionVisible}">
                        <Label Grid.Row="0" Text="{Binding CategoriesCountText}" Style="{StaticResource CountLabel}" />
                        <CollectionView Grid.Row="1" ItemsSource="{Binding Categories}" SelectionMode="None">
                            <CollectionView.EmptyView>
                                <Label Text="Разделов пока нет." Style="{StaticResource EmptyLabel}" />
                            </CollectionView.EmptyView>

                            <CollectionView.ItemTemplate>
                                <DataTemplate x:DataType="models:Category">
                                    <controls:CatalogRow
                                        LongPressCommand="{Binding Source={x:Reference CatalogPage}, Path=BindingContext.CategoryActionsCommand}"
                                        OverflowCommand="{Binding Source={x:Reference CatalogPage}, Path=BindingContext.CategoryActionsCommand}"
                                        CommandParameter="{Binding .}"
                                        OverflowDescription="{Binding Name, StringFormat='Действия с разделом {0}'}">
                                        <controls:CatalogRow.RowContent>
                                            <Label Text="{Binding Name}" Style="{StaticResource RowTitle}" />
                                        </controls:CatalogRow.RowContent>
                                    </controls:CatalogRow>
                                </DataTemplate>
                            </CollectionView.ItemTemplate>
                        </CollectionView>
                    </Grid>

                    <!-- ── MODIFIERS ── -->
                    <Grid RowDefinitions="Auto,*" IsVisible="{Binding IsModifiersSectionVisible}">
                        <Label Grid.Row="0" Text="{Binding ModifierGroupsCountText}" Style="{StaticResource CountLabel}" />
                        <CollectionView Grid.Row="1" ItemsSource="{Binding ModifierOptionGroups}" SelectionMode="None"
                                        IsGrouped="True">
                            <CollectionView.GroupHeaderTemplate>
                                <DataTemplate x:DataType="vm:ModifierOptionGroup">
                                    <controls:CatalogRow IsHeader="True"
                                        LongPressCommand="{Binding Source={x:Reference CatalogPage}, Path=BindingContext.ModifierGroupActionsCommand}"
                                        OverflowCommand="{Binding Source={x:Reference CatalogPage}, Path=BindingContext.ModifierGroupActionsCommand}"
                                        CommandParameter="{Binding .}"
                                        OverflowDescription="{Binding Name, StringFormat='Действия с группой {0}'}">
                                        <controls:CatalogRow.RowContent>
                                            <Label Text="{Binding Name}" TextColor="White" FontAttributes="Bold" FontSize="13" />
                                        </controls:CatalogRow.RowContent>
                                    </controls:CatalogRow>
                                </DataTemplate>
                            </CollectionView.GroupHeaderTemplate>
                            <CollectionView.EmptyView>
                                <Label Text="Модификаторов пока нет." Style="{StaticResource EmptyLabel}" />
                            </CollectionView.EmptyView>

                            <CollectionView.ItemTemplate>
                                <DataTemplate x:DataType="models:ModifierOption">
                                    <controls:CatalogRow
                                        LongPressCommand="{Binding Source={x:Reference CatalogPage}, Path=BindingContext.ModifierOptionActionsCommand}"
                                        OverflowCommand="{Binding Source={x:Reference CatalogPage}, Path=BindingContext.ModifierOptionActionsCommand}"
                                        CommandParameter="{Binding .}"
                                        OverflowDescription="{Binding Name, StringFormat='Действия с модификатором {0}'}">
                                        <controls:CatalogRow.RowContent>
                                            <Grid RowDefinitions="Auto,Auto" RowSpacing="4">
                                                <Label Text="{Binding Name}" Style="{StaticResource RowTitle}" />
                                                <FlexLayout Grid.Row="1" Direction="Row" Wrap="Wrap"
                                                            VerticalOptions="Center">
                                                    <Border Style="{StaticResource TagWarning}" Margin="2,2"
                                                            IsVisible="{Binding IsAvailable, Converter={StaticResource InvertedBoolConverter}}">
                                                        <Label Text="Нет в наличии" Style="{StaticResource TagTextWarning}" />
                                                    </Border>
                                                    <!-- "Группа: " with nothing after it rendered on every row,
                                                         because GetModifierGroupsAsync never loaded the inverse
                                                         ModifierOption.ModifierGroup navigation. The query is fixed
                                                         and this guard makes the label impossible to render empty. -->
                                                    <Border Style="{StaticResource TagInfo}" Margin="2,2"
                                                            IsVisible="{Binding ModifierGroup, Converter={StaticResource IsPresent}}">
                                                        <Label Text="{Binding ModifierGroup.Name, StringFormat='Группа: {0}'}"
                                                               Style="{StaticResource TagTextInfo}" />
                                                    </Border>
                                                </FlexLayout>
                                            </Grid>
                                        </controls:CatalogRow.RowContent>
                                    </controls:CatalogRow>
                                </DataTemplate>
                            </CollectionView.ItemTemplate>
                        </CollectionView>
                    </Grid>

                    <!-- ── INGREDIENTS ── -->
                    <Grid RowDefinitions="Auto,Auto,*" IsVisible="{Binding IsIngredientsSectionVisible}">
                        <Border Grid.Row="0" Style="{StaticResource Tag}" Padding="8,6" StrokeShape="RoundRectangle 6"
                                BackgroundColor="{AppThemeBinding Light={StaticResource WarningLight}, Dark={StaticResource Gray800}}"
                                IsVisible="{Binding HasLowStock}">
                            <!-- The dark branch used to be Warning in BOTH, over a fill that flipped to grey —
                                 the signature of a missing dark token rather than an
                                 intentional constant. This was the fourth instance of that pairing in
                                 the app and the one the palette pass left behind: it sat at 1.99:1
                                 against the old Gray700, because the light Warning token cannot
                                 carry a dark tonal fill. The fill is now Gray800 (the dark tonal
                                 fill every other label-on-fill pair in Styles.xaml uses) and the
                                 label takes WarningDark, 5.81:1 there.

                                 THE LIGHT BRANCH WAS THE SAME GAP, AND IT IS NOW CLOSED. It was
                                 Warning on this pill's own WarningLight #FFF3E0 fill: 2.84:1, on a
                                 12pt bold label, which owes 4.5:1. It could not be fixed from this
                                 file, because the palette had no darker orange to reach for —
                                 Warning #ED6C02 is the only warm token and it is 2.84:1 on a fill
                                 that is already nearly white. Colors.xaml now carries WarningText
                                 #A35B00, and this label takes it:
                                   WarningText #A35B00 on WarningLight #FFF3E0   4.72:1  (light, was 2.84:1)
                                   WarningDark #FFB74D on Gray800 #424242        5.81:1  (dark, unchanged)
                                 The fill is deliberately NOT changed: it is a tonal pill, not a
                                 text background, and WarningToolbarButton / TagWarning already
                                 established that Warning as a saturated fill is the one pairing
                                 that works (Gray900 #212121 on it is 5.17:1; WarningText on that
                                 same fill would be 1.66:1). What changed is only the ink.

                                 The state is still carried by the wording and the leading "!",
                                 never by the tint, so nothing here signals state by colour alone. -->
                            <Label FontSize="12" FontAttributes="Bold" LineBreakMode="WordWrap"
                                   TextColor="{AppThemeBinding Light={StaticResource WarningText}, Dark={StaticResource WarningDark}}"
                                   Text="{Binding LowStockText}" />
                        </Border>

                        <Label Grid.Row="1" Text="{Binding IngredientsCountText}" Style="{StaticResource CountLabel}" />

                        <CollectionView Grid.Row="2" ItemsSource="{Binding Ingredients}" SelectionMode="None">
                            <CollectionView.EmptyView>
                                <Label Text="Ингредиентов пока нет." Style="{StaticResource EmptyLabel}" />
                            </CollectionView.EmptyView>

                            <CollectionView.ItemTemplate>
                                <DataTemplate x:DataType="models:Ingredient">
                                    <controls:CatalogRow
                                        LongPressCommand="{Binding Source={x:Reference CatalogPage}, Path=BindingContext.IngredientActionsCommand}"
                                        OverflowCommand="{Binding Source={x:Reference CatalogPage}, Path=BindingContext.IngredientActionsCommand}"
                                        CommandParameter="{Binding .}"
                                        OverflowDescription="{Binding Name, StringFormat='Действия с ингредиентом {0}'}">
                                        <controls:CatalogRow.RowContent>
                                            <Grid RowDefinitions="Auto,Auto" RowSpacing="4">
                                                <Label Text="{Binding Name}" Style="{StaticResource RowTitle}" />
                                                <!-- Four pills in a fixed row: stock, cost and minimum clipped
                                                     off-screen on a narrow phone. They wrap now. -->
                                                <FlexLayout Grid.Row="1" Direction="Row" Wrap="Wrap"
                                                            VerticalOptions="Center">
                                                    <Border Style="{StaticResource TagWarning}" Margin="2,2"
                                                            IsVisible="{Binding IsAvailable, Converter={StaticResource InvertedBoolConverter}}">
                                                        <Label Text="Нет в наличии" Style="{StaticResource TagTextWarning}" />
                                                    </Border>
                                                    <Border Style="{StaticResource Tag}" Margin="2,2">
                                                        <Label Text="{Binding StockText}" Style="{StaticResource TagText}" />
                                                    </Border>
                                                    <Border Style="{StaticResource Tag}" Margin="2,2">
                                                        <Label Text="{Binding CostPerUnitText}" Style="{StaticResource TagText}" />
                                                    </Border>
                                                    <Border Style="{StaticResource TagInfo}" Margin="2,2">
                                                        <Label Text="{Binding MinStockText}" Style="{StaticResource TagTextInfo}" />
                                                    </Border>
                                                </FlexLayout>
                                            </Grid>
                                        </controls:CatalogRow.RowContent>
                                    </controls:CatalogRow>
                                </DataTemplate>
                            </CollectionView.ItemTemplate>
                        </CollectionView>
                    </Grid>

                </Grid>

                <!-- ═══ FAB ═══ -->
                <!-- An extended FAB: the "add" mark plus a label naming what it will add, because the
                     four sections mean four different things and a bare "+" says none of them. The
                     label is also the screen-reader name, so it is a real phrase rather than a shape.
                     It is a true overlay — a child of the content Grid, VerticalOptions=End /
                     HorizontalOptions=End. It floats over the list; the list scrolls underneath it.
                     The FAB may overlap the last row; the operator nudges it out from under by scrolling.
                     VerticalOptions=End / HorizontalOptions=End on the ContentView itself (not just
                     the inner Border) make the container occupy only the bottom-end corner where the
                     pill is, so it cannot swallow touches on the list area — a ContentView defaults
                     to LayoutOptions.Fill and would otherwise cover the whole cell. -->
                <controls:FloatingActionButton x:Name="AddFab" VerticalOptions="End" HorizontalOptions="End"
                                                Label="{Binding AddButtonText}"
                                                Description="{Binding AddButtonText}"
                                                Command="{Binding Source={x:Reference CatalogPage}, Path=BindingContext.ShowAddFormCommand}" />
            </Grid>
    </Grid>
</ContentPage>
