<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui" xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml" xmlns:vm="clr-namespace:CafePos.Presentation.ViewModels;assembly=CafePos.Presentation" xmlns:backup="clr-namespace:CafePos.Core.Services;assembly=CafePos.Core" x:Class="CafePosApp.Views.SettingsPage" x:DataType="vm:SettingsViewModel" Title="Настройки"
             Shell.NavBarIsVisible="False">
    <ScrollView>
        <VerticalStackLayout Padding="16" Spacing="12">
            <!-- No PageTitle label. It was first dropped because the Shell nav bar already read
                 "Настройки" and the page repeated it as "Настройки приложения" underneath — the
                 same word twice, in two sizes, before any content. The nav bar is now hidden on
                 this page too (Shell.NavBarIsVisible on the root), because it duplicated the
                 "Настройки" tab label; the tab bar is what names the section. So the section
                 headings below carry the structure, exactly as before. -->

            <Border Style="{StaticResource CardBorder}">
                <VerticalStackLayout Spacing="10">
                    <Label Text="Внешний вид и поведение" Style="{StaticResource SectionTitle}" />
                    <!-- Persistent labels, not placeholders. All four of these fields arrive
                         populated on the second visit, and an Entry drops its Placeholder as
                         soon as Text is set, so the page read as four anonymous values with no
                         indication of what any of them was. -->
                    <VerticalStackLayout Spacing="2">
                        <Label Text="Название кафе" Style="{StaticResource FieldLabel}" />
                        <Entry Style="{StaticResource FormField}" Placeholder="Например, Café Bar" Text="{Binding CafeName}" ClearButtonVisibility="WhileEditing" />
                    </VerticalStackLayout>
                    <VerticalStackLayout Spacing="2">
                        <Label Text="Интервал обновления заказов, сек. (5–300)" Style="{StaticResource FieldLabel}" />
                        <Entry Style="{StaticResource FormField}" Placeholder="15" Text="{Binding AutoRefreshSecondsText}" Keyboard="Numeric" />
                    </VerticalStackLayout>
                    <VerticalStackLayout Spacing="2">
                        <Label Text="Префикс номера заказа" Style="{StaticResource FieldLabel}" />
                        <Entry Style="{StaticResource FormField}" Placeholder="Заказ" Text="{Binding OrderPrefix}" />
                    </VerticalStackLayout>
                    <VerticalStackLayout Spacing="2">
                        <Label Text="Тема оформления" Style="{StaticResource FieldLabel}" />
                        <Picker Style="{StaticResource FormFieldPicker}" Title="Тема оформления" ItemsSource="{Binding Themes}" SelectedItem="{Binding ThemeText}" />
                    </VerticalStackLayout>
                    <!-- The currency, with its own worked example underneath. That summary line is
                         not decoration: CNY and JPY share the ¥ sign and differ ONLY in decimal
                         places, so a title-only picker would leave the operator unable to tell the
                         two apart — see SettingsViewModel.CurrencySummary.
                         Bound by CODE, not by Title, so the saved value survives a translation pass.
                         The digit count after the comma comes from the currency itself and is not a
                         separate setting: every preset carries its own correct minor unit. -->
                    <VerticalStackLayout Spacing="2">
                        <Label Text="Валюта" Style="{StaticResource FieldLabel}" />
                        <Picker Style="{StaticResource FormFieldPicker}" Title="Валюта"
                                ItemsSource="{Binding CurrencyList}"
                                ItemDisplayBinding="{Binding Title}"
                                SelectedItem="{Binding SelectedCurrency}" />
                        <Label Text="{Binding CurrencySummary}" Style="{StaticResource SecondaryLabel}" FontSize="12" />
                    </VerticalStackLayout>
                    <Label Text="Настройки сохраняются только на этом устройстве." Style="{StaticResource SecondaryLabel}" />
                    <Button Text="Сохранить настройки" Command="{Binding SaveCommand}" />
                    <!-- Colour comes from MessageColor, not from an AppThemeBinding here: AppThemeBinding only
                         governs values that come from XAML, so it cannot switch on a bound property,
                         and this label has to change with the severity. The ViewModel resolves
                         Success/SuccessDark or Danger/DangerDark through ThemeColors, which is the
                         same answer OrdersViewModel.StatusColor gives.
                         The message text always says what happened, so the colour is a second cue
                         and never the message — six of the paths that write here are failures. -->
                    <Label Text="{Binding Message}" IsVisible="{Binding HasMessage}"
                           TextColor="{Binding MessageColor}" />
                </VerticalStackLayout>
            </Border>

            <Border Style="{StaticResource CardBorder}">
                <VerticalStackLayout Spacing="10">
                    <Label Text="Данные и резервные копии" Style="{StaticResource SectionTitle}" />
                    <Grid ColumnDefinitions="*,*" ColumnSpacing="8">
                        <Button Text="Создать копию" Command="{Binding CreateBackupCommand}" />
                        <Button Grid.Column="1" Text="Экспорт данных" Command="{Binding ExportDataCommand}" />
                    </Grid>
                    <!-- The catalogue CSV round-trip, moved here from the catalogue screen. There it
                         was one «CSV» button whose only entry point was an action sheet, a few
                         millimetres from every product's price — and one of the two directions
                         rewrites working rows. Both are data-in / data-out against the same
                         database this card already backs up and restores, so the card is where they
                         belong. Export is grouped with the other data-OUT actions, ABOVE the
                         warning below; import is not, and never will be.
                         The caption is here because «CSV» is the only format name on this card and
                         the button alone does not say what a CSV is for.
                    -->
                    <Label Text="Формат CSV — для переноса каталога на другое устройство." Style="{StaticResource Caption}" />
                    <Button Text="Экспорт каталога в CSV" Style="{StaticResource SecondaryButton}" Command="{Binding ExportCsvCommand}" />

                    <!-- Restoring overwrites the working database, so it carries DangerButton and
                         a written warning rather than the same filled primary as "Создать копию"
                         next to it. Two identical primary buttons either side of a
                         data-destroying action is how an operator loses a day's takings.
                         The warning now names BOTH buttons below it, and import carries DangerButton
                         too: it rewrites the working catalogue with no undo and no restart, which
                         is the same family of consequence as a restore, and it asks before it
                         writes (SettingsViewModel.Catalog.cs). Two same-coloured buttons in a row
                         is deliberate — the difference between them is written on them, not only
                         drawn in. -->
                    <Label Text="Восстановление заменит текущую базу данными из копии, а импорт CSV перезапишет товары в каталоге." Style="{StaticResource FieldLabel}" />
                    <Button Text="Восстановить из копии…" Style="{StaticResource DangerButton}" Command="{Binding RestoreBackupCommand}" />
                    <Button Text="Импорт каталога из CSV…" Style="{StaticResource DangerButton}" Command="{Binding ImportCsvCommand}" />
                    <!-- A CollectionView inside a ScrollView created two competing scrollers: on
                         Android the inner one won the drag gesture and froze the page. BindableLayout
                         keeps a single scroller (the ScrollView) and renders the same rows. -->
                    <VerticalStackLayout BindableLayout.ItemsSource="{Binding Backups}" Spacing="2">
                        <BindableLayout.ItemTemplate>
                            <DataTemplate x:DataType="backup:BackupInfo">
                                <Grid ColumnDefinitions="*,Auto" Padding="0,2">
                                    <Label Text="{Binding FileName}" FontSize="12" LineBreakMode="TailTruncation" />
                                    <Label Grid.Column="1" Text="{Binding SizeText}" Style="{StaticResource Caption}" />
                                </Grid>
                            </DataTemplate>
                        </BindableLayout.ItemTemplate>
                    </VerticalStackLayout>
                    <Button Text="Отправить журнал" Style="{StaticResource SecondaryButton}" Command="{Binding ShareLogCommand}" />
                </VerticalStackLayout>
            </Border>
        </VerticalStackLayout>
    </ScrollView>
</ContentPage>
