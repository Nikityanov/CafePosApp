<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui" xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml" xmlns:vm="clr-namespace:CafePosApp.ViewModels" x:Class="CafePosApp.Views.OrderDetailsPage" x:DataType="vm:OrderDetailsViewModel" Title="Детали заказа"
             Shell.NavBarIsVisible="True"><!-- Explicit, not inherited: this page is pushed from
             OrdersPage, which sets the property False to drop its duplicate tab title, and the
             back arrow on this page depends on the bar being there. Verified on the emulator. -->
    <Grid RowDefinitions="Auto,Auto,*,Auto" Padding="16" RowSpacing="10">
        <Grid ColumnDefinitions="*,Auto">
            <VerticalStackLayout>
                <Label Text="{Binding OrderTitle}" FontSize="22" FontAttributes="Bold" />
                <Label Text="{Binding StatusText}" Style="{StaticResource SecondaryLabel}" />
            </VerticalStackLayout>
            <ActivityIndicator Grid.Column="1" IsRunning="{Binding IsBusy}" IsVisible="{Binding IsBusy}" />
        </Grid>
        <!-- The value here is static — every message this ViewModel raises is a failure — so an
             AppThemeBinding on the attribute is the whole fix and needs no ViewModel change. A bare
             {StaticResource Danger} declared the light token in both themes: on the page fill
             (#FAFAFA / #121212, this page has no CardBorder) that is 4.77:1 in light and 3.76:1 in
             dark, and at 14pt regular 3.76:1 fails the 4.5:1 it owes. DangerDark #FF9E8E on #121212
             is 9.40:1. -->
        <Label Grid.Row="1" Text="{Binding Message}" IsVisible="{Binding HasMessage}"
               TextColor="{AppThemeBinding Light={StaticResource Danger}, Dark={StaticResource DangerDark}}"
               LineBreakMode="WordWrap" />
        <CollectionView Grid.Row="2" ItemsSource="{Binding Items}" SelectionMode="None">
            <CollectionView.EmptyView>
                <Label Text="В заказе нет блюд." Style="{StaticResource EmptyLabel}" />
            </CollectionView.EmptyView>
            <CollectionView.ItemTemplate>
                <DataTemplate x:DataType="vm:OrderEditItemViewModel">
                    <Grid ColumnDefinitions="*,Auto,Auto" ColumnSpacing="8" Padding="0,6">
                        <VerticalStackLayout Spacing="2">
                            <Label Text="{Binding ProductName}" FontAttributes="Bold" />
                            <Label Text="{Binding SelectedModifierName, StringFormat='Модификатор: {0}'}" Style="{StaticResource SecondaryLabel}" IsVisible="{Binding SelectedModifierName, Converter={StaticResource IsPresent}}" />
                            <Label Text="{Binding SelectedVariantName, StringFormat='Вариант: {0}'}" Style="{StaticResource SecondaryLabel}" IsVisible="{Binding SelectedVariantName, Converter={StaticResource IsPresent}}" />
                            <!-- LineTotalText, not StringFormat='{0:F2} ₽': see
                                 OrderEditItemViewModel.LineTotalText. -->
                            <Label Text="{Binding LineTotalText}" Style="{StaticResource SecondaryLabel}" />
                        </VerticalStackLayout>
                        <!-- The steppers and the delete button were 36dp, below the 44dp touch
                             minimum every other control in the app honours. -->
                        <Grid Grid.Column="1" ColumnDefinitions="48,24,48" VerticalOptions="Center">
                            <Button Text="−" Padding="0" FontSize="18" HeightRequest="48" WidthRequest="48" MinimumHeightRequest="48" MinimumWidthRequest="48" SemanticProperties.Description="Убрать одну штуку" Command="{Binding Source={RelativeSource AncestorType={x:Type ContentPage}}, Path=BindingContext.DecreaseItemCommand}" CommandParameter="{Binding .}" IsEnabled="{Binding Source={RelativeSource AncestorType={x:Type ContentPage}}, Path=BindingContext.CanEdit}" />
                            <Label Grid.Column="1" Text="{Binding Quantity}" HorizontalTextAlignment="Center" VerticalTextAlignment="Center" />
                            <Button Grid.Column="2" Text="+" Padding="0" FontSize="18" HeightRequest="48" WidthRequest="48" MinimumHeightRequest="48" MinimumWidthRequest="48" SemanticProperties.Description="Добавить ещё одну" Command="{Binding Source={RelativeSource AncestorType={x:Type ContentPage}}, Path=BindingContext.IncreaseItemCommand}" CommandParameter="{Binding .}" IsEnabled="{Binding Source={RelativeSource AncestorType={x:Type ContentPage}}, Path=BindingContext.CanEdit}" />
                        </Grid>
                        <Button Grid.Column="2" Text="Удалить" Style="{StaticResource DangerButton}" FontSize="12" Padding="8,4" MinimumHeightRequest="44" Command="{Binding Source={RelativeSource AncestorType={x:Type ContentPage}}, Path=BindingContext.RemoveItemCommand}" CommandParameter="{Binding .}" IsEnabled="{Binding Source={RelativeSource AncestorType={x:Type ContentPage}}, Path=BindingContext.CanEdit}" />
                    </Grid>
                </DataTemplate>
            </CollectionView.ItemTemplate>
        </CollectionView>
        <VerticalStackLayout Grid.Row="3" Spacing="8">
            <Picker Title="Добавить блюдо" ItemsSource="{Binding AvailableProducts}" ItemDisplayBinding="{Binding Name}" SelectedItem="{Binding SelectedProduct}" IsEnabled="{Binding CanEdit}" />
            <!-- The total used to sit BELOW the action buttons, right-aligned and clipped by the
                 tab bar — the most important number on an order-editing screen was the last thing
                 on it and the easiest to miss. It now heads the action block, above the
                 "Добавить блюдо" field, where the cart already puts it. -->
            <Label Text="{Binding TotalText, StringFormat='Итого: {0}'}" FontAttributes="Bold" FontSize="20" HorizontalTextAlignment="End" />
            <!-- Payment area: what was paid, what came back and what is left. The total is right
                 above, so this line carries the figures; the wording (not just the colour) carries
                 the state, and a refunded order says it was refunded rather than reading as unpaid.
                 -->
            <Label Text="{Binding PaymentSummary}" FontSize="13" FontAttributes="Bold" TextColor="{Binding PaymentColor}" LineBreakMode="WordWrap" />
            <Button Text="Принять оплату" Style="{StaticResource SecondaryButton}" MinimumHeightRequest="48" IsVisible="{Binding CanCollectPayment}" Command="{Binding CollectPaymentCommand}" SemanticProperties.Description="Принять оплату по заказу" />

            <!-- «Вернуть оплату» sits in the payment block, beside «Принять оплату», because it is
                 the same control facing the other way and an operator looking for it will look
                 there. Visible only on a Completed order that still holds money (CanRefundPayment):
                 the domain restricts refunds to finished sales, and the NET scalar is what makes the
                 button disappear once everything has been given back — so a fully refunded order
                 never offers a control that can only fail.
                 DangerButton rather than SecondaryButton because money leaves the till. The colour
                 is NOT the signal: the wording is («Вернуть», not «Оплата»), and the sheet it opens
                 is titled and captioned as a return as well. -->
            <Button Text="Вернуть оплату" Style="{StaticResource DangerButton}" MinimumHeightRequest="48" IsVisible="{Binding CanRefundPayment}" Command="{Binding RefundPaymentCommand}" SemanticProperties.Description="Вернуть часть оплаты по закрытому заказу" />

            <!-- The individual payments, one line each.

                 Two columns: the words on the left, the signed amount on the right. A refund row
                 used to render identically to a collection row — the same text for money in and for
                 money out — because the ledger is one table and IsRefund is a flag, not a shape.
                 Now the amount carries a minus sign, the text carries «возврат», and the amount is
                 tinted. The tint is the THIRD signal and never the only one: colour alone is refused
                 throughout this app, and a screen reader is given the word, not the colour.

                 The tint comes from PaymentLine.AmountColor rather than from the template, because a
                 DataTrigger's Setter takes a VALUE and not a binding expression: every token put in
                 one — plain {StaticResource Danger}, and then an AppThemeBinding inside the very
                 same Setter — resolved once at parse time and stayed light-themed in dark mode. It
                 went through both, and at 12pt bold this label owes 4.5:1, where it was getting
                 3.76:1. A bound property resolves against the theme that is actually running; see
                 its remarks for the numbers and for the one coupling it introduces. -->
            <VerticalStackLayout BindableLayout.ItemsSource="{Binding Payments}" Spacing="2">
                <BindableLayout.ItemTemplate>
                    <DataTemplate x:DataType="vm:PaymentLine">
                        <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
                            <Label Text="{Binding Text}" FontSize="12" Style="{StaticResource SecondaryLabel}" />
                            <Label Grid.Column="1" Text="{Binding AmountText}" FontSize="12" FontAttributes="Bold"
                                   VerticalTextAlignment="Start" TextColor="{Binding AmountColor}" />
                        </Grid>
                    </DataTemplate>
                </BindableLayout.ItemTemplate>
            </VerticalStackLayout>

            <Button Text="Добавить в заказ" Command="{Binding AddProductCommand}" IsEnabled="{Binding CanEdit}" />
            <Grid ColumnDefinitions="*,*" ColumnSpacing="8">
                <Button Text="Сохранить" Command="{Binding SaveCommand}" IsEnabled="{Binding CanEdit}" />
                <!-- Was Command="{Binding CancelCommand}", which OrderDetailsViewModel does not
                     declare - it exposes BackCommand. The binding resolved to null, so this button
                     rendered disabled and "Назад" did nothing: the operator could not leave this
                     screen by the button at all, and BackCommand was bound nowhere, i.e. dead code.
                     x:DataType is what made the mismatch visible at build time. -->
                <Button Grid.Column="1" Text="Назад" Style="{StaticResource SecondaryButton}" Command="{Binding BackCommand}" />
            </Grid>

            <!-- The void. This page had no cancel control at all before, which left the natural
                 place to undo one specific order unable to undo anything: the operator had to go
                 and find the row on a different screen. Same three dialogs as the board's cancel,
                 in the same order and with the same per-row wording, so the two entry points cannot
                 drift apart on the phrasing that tells the operator money is leaving. CanCancel
                 keeps it off an already-cancelled order, where the domain would refuse it.

                 Last in the block on purpose: it is the most destructive thing on the page, and it
                 reads after everything the operator might have wanted instead. -->
            <Button Text="{Binding CancelText}" Style="{StaticResource DangerButton}" MinimumHeightRequest="48" IsVisible="{Binding CanCancel}" Command="{Binding CancelOrderCommand}" SemanticProperties.Description="{Binding CancelHint}" />
        </VerticalStackLayout>
    </Grid>
</ContentPage>