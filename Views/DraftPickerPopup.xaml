<?xml version="1.0" encoding="utf-8" ?>
<toolkit:Popup x:TypeArguments="x:String" xmlns="http://schemas.microsoft.com/dotnet/2021/maui" xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml" xmlns:toolkit="http://schemas.microsoft.com/dotnet/2022/maui/toolkit" x:Class="CafePosApp.Views.DraftPickerPopup" x:DataType="x:String">
    <ScrollView MaximumHeightRequest="520">
        <VerticalStackLayout Padding="20" Spacing="12">
            <Label x:Name="TitleLabel" FontSize="22" FontAttributes="Bold" />
            <Label Text="Выберите отложенный заказ" Style="{StaticResource SecondaryLabel}" />
            <VerticalStackLayout x:Name="OptionsLayout" Spacing="8" />
        </VerticalStackLayout>
    </ScrollView>
</toolkit:Popup>
