<Project Sdk="Microsoft.NET.Sdk">

	<PropertyGroup>
		<TargetFrameworks>net10.0-android</TargetFrameworks>
		<TargetFrameworks Condition="!$([MSBuild]::IsOSPlatform('linux'))">$(TargetFrameworks);net10.0-ios;net10.0-maccatalyst</TargetFrameworks>
		<TargetFrameworks Condition="$([MSBuild]::IsOSPlatform('windows'))">$(TargetFrameworks);net10.0-windows10.0.19041.0</TargetFrameworks>

		<OutputType>Exe</OutputType>
		<RootNamespace>CafePosApp</RootNamespace>
		<UseMaui>true</UseMaui>
		<SingleProject>true</SingleProject>
		<ImplicitUsings>enable</ImplicitUsings>
		<Nullable>enable</Nullable>

		<!--
		  XamlC and the `Path=BindingContext.*` idiom.

		  The app binds a row's control to a command that lives on the PAGE's ViewModel, which means
		  Source={x:Reference SomePageRoot} Path=BindingContext.SomeCommand. The alternative,
		  RelativeSource AncestorType={vm:SomeViewModel}, makes the XAML runtime try to INSTANTIATE that
		  ViewModel and throws XamlParseException on every DI type without a parameterless constructor —
		  which is all of them. So this idiom is not laziness, it is the only one that runs, and it
		  is used 39 times across 7 pages.

		  Those 39 bindings raised XC0045 on every build, and the number is not reducible by changing the
		  idiom: BindableObject.BindingContext is typed `object`, so the SECOND segment of the path can
	  never be resolved statically, and adding an inline x:DataType only moves the complaint to
		  `Property "X" not found on "System.Object"`. Verified against Microsoft.Maui.Controls 10.0.101
		  in a throw-away project: `Path=BindingContext.*` is structurally non-compilable.

		  What is actually being given up is narrow. XC0045 does NOT check the second segment: rename
		  SomeCommand on the ViewModel and you get the same 39 warnings plus a silently dead button, so
		  XC0045 carries no information about the path by construction. What it does check is the SOURCE
		  TYPE, and that is the one thing that now goes quiet — a binding whose Source type is wrong
	  becomes silent. Hence WarningsAsErrors below: everything XamlC genuinely can check becomes a
		  build error, so the suppression is narrow by construction and not by agreement.

		  XC0022 is deliberately NOT suppressed. All six are Picker.ItemDisplayBinding, which has no
		  x:DataType scope to be given, and each was checked by hand against its source type. Those six
	  are the only diagnostics left on six bindings nothing can verify — six lines of noise is the
		  price of keeping them.
		-->
		<NoWarn>$(NoWarn);XC0045</NoWarn>
		<WarningsAsErrors>$(WarningsAsErrors);XC0023;XC0024;XC0025</WarningsAsErrors>

		<!-- Display name -->
		<ApplicationTitle>CafePosApp</ApplicationTitle>

		<!--
		  App Identifier: intentionally NOT changed — a different id installs a second copy of the
		  app on the device and the operator would lose the local database.
		-->
		<ApplicationId>com.companyname.cafeposapp</ApplicationId>

		<!-- Versions -->
		<ApplicationDisplayVersion>1.1</ApplicationDisplayVersion>
		<ApplicationVersion>2</ApplicationVersion>

		<WindowsPackageType>None</WindowsPackageType>
		<EmbedAssembliesIntoApk Condition="'$(Configuration)' == 'Debug'">true</EmbedAssembliesIntoApk>

		<!--
		  XamlC can compile {Binding X, Source={x:Reference Y}} only when told to; without this it
		  reports XC0025 for every one and leaves the binding to be resolved by reflection at runtime.
		  Controls/CatalogRow.xaml and Controls/FloatingActionButton.xaml are entirely made of such
		  bindings: the commands and content arrive as bindable properties and are read back through a
		  forward reference inside the control's own namescope (the direction that is safe — the
		  reverse, looking *up* to the host from inside a DataTemplate, is the failure the CatalogRow
		  header comment documents). Those sources are x:Reference resolvable, so source compilation
		  applies and is type-checked at build time like any other binding.
		-->
		<MauiEnableXamlCBindingWithSourceCompilation>true</MauiEnableXamlCBindingWithSourceCompilation>

		<SupportedOSPlatformVersion Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'ios'">15.0</SupportedOSPlatformVersion>
		<SupportedOSPlatformVersion Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'maccatalyst'">15.0</SupportedOSPlatformVersion>
		<SupportedOSPlatformVersion Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'android'">21.0</SupportedOSPlatformVersion>
		<SupportedOSPlatformVersion Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'windows'">10.0.17763.0</SupportedOSPlatformVersion>
		<TargetPlatformMinVersion Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'windows'">10.0.17763.0</TargetPlatformMinVersion>
	</PropertyGroup>

	<!--
	  CafePos.Core (platform independent, unit tested) and CafePos.Tests live in subfolders of this
	  project folder, so they must be excluded from the MAUI compile globs.
	-->
	<ItemGroup>
		<Compile Remove="Core\**" />
		<Compile Remove="Tests\**" />
		<None Remove="Core\**" />
		<None Remove="Tests\**" />
		<EmbeddedResource Remove="Core\**" />
		<EmbeddedResource Remove="Tests\**" />
		<MauiXaml Remove="Core\**" />
		<MauiXaml Remove="Tests\**" />
		<MauiAsset Remove="Core\**" />
		<MauiAsset Remove="Tests\**" />
		<MauiImage Remove="Core\**" />
		<MauiImage Remove="Tests\**" />
		<MauiFont Remove="Core\**" />
		<MauiFont Remove="Tests\**" />
		<ProjectReference Include="Core\CafePos.Core.csproj" />
	</ItemGroup>

	<ItemGroup>
		<!--
		  App Icon.

		  Include         the BACKGROUND layer: a flat #143D59 fill, nothing else. Android
		                  gives the background layer no mask inset, so full bleed is correct.
		                  This used to carry the whole logo as well, which drew the mark twice
		                  - at two scales, in two colour schemes - stacked on each other.
		  ForegroundFile  the mark: gold on the navy background.
		  Color           the background colour, declared here once. appicon.svg and the
		                  generated mipmap/appicon_background are rasterised from this.

		  The mark is 63.7dp across on the 108dp adaptive-icon canvas, measured from the
		  geometry in appiconfg.svg: inside the 72dp maskable zone with 4.2dp to spare and
		  inside the 66dp guaranteed-visible unmasked zone with 1.2dp to spare, against a
		  48dp legibility floor. The old gold disc was 67.3dp - it filled 93.5% of the
		  maskable diameter, which is why it read as a yellow blob. See the comment block in
		  Resources/AppIcon/appiconfg.svg for the full measurement.

		  Two Android-specific things are NOT expressible here in MAUI 10.0.101, and both are
		  handled by project resources instead of by attributes on this item:

		    - The themed (monochrome) icon. Resizetizer hard-codes
		      <monochrome android:drawable="@mipmap/appicon_foreground"/>, so the themed layer
		      would be the full-colour raster and collapse to a featureless filled circle when
		      flattened to one tint. MonochromeFile is a MAUI 11 property. The real layer is
		      Platforms/Android/Resources/drawable/cafepos_icon_monochrome.xml, wired up by
		      Platforms/Android/Resources/mipmap-anydpi-v26/cafepos_icon.xml and pointed at by
		      AndroidManifest.xml.
		    - The Android 12+ splash icon size. See the MauiSplashScreen item below.

		  Do NOT add ForegroundScale here to shrink the mark. It is not Android-specific: the
		  same attribute feeds the legacy raster, the iOS asset catalogue and the Windows .ico,
		  so shrinking the adaptive layers that way shrinks every platform. The mark is sized
		  correctly in the SVG instead, and the layer separation above removes the other reason
		  it was ever needed.
		-->
		<MauiIcon Include="Resources\AppIcon\appicon.svg" ForegroundFile="Resources\AppIcon\appiconfg.svg" Color="#143D59" />

		<!--
		  Splash Screen.

		  BaseSize 128,128 stays: it is the documented recommended value and it is the
		  pre-31 path. The generated drawable/maui_splash_image.xml draws the raster centred
		  and unscaled, so the 456-unit viewBox maps 1:1 onto 128dp. splash.svg is therefore
		  NOT a 108-canvas asset, and its mark is drawn at 1.18x the icon's scale so it lands
		  89dp across on that 128dp box - 63.7dp (the icon's own size, unscaled) is a timid
		  logo for a screen that is entirely about the brand.

		  The artwork no longer has a navy disc behind the gold cup. It used to, on a navy
		  #143D59 splash background, so the disc was invisible and only the cup read.

		  API 31+ cannot be fixed from here: MAUI points windowSplashScreenAnimatedIcon at
		  @drawable/maui_splash, a layer-list that includes the opaque background fill, and
		  hard-codes the logo into a 108dp item where Android's spec wants 240 or 288dp. MAUI
		  10.0.101 exposes no attribute for any of it. The fix is a project-level
		  Platforms/Android/Resources/values/styles.xml that redefines Maui.SplashTheme with
		  the library's own parent chain, plus drawable/cafepos_splash_icon.xml as an
		  icon-only 288dp vector. Both carry the reasoning in their own comments.
		-->
		<MauiSplashScreen Include="Resources\Splash\splash.svg" Color="#143D59" BaseSize="128,128" />

		<!-- Images -->
		<MauiImage Include="Resources\Images\*" />

		<!-- Custom Fonts -->
		<MauiFont Include="Resources\Fonts\*" />

		<!-- Raw Assets (also remove the "Resources\Raw" prefix) -->
		<MauiAsset Include="Resources\Raw\**" LogicalName="%(RecursiveDir)%(Filename)%(Extension)" />
	</ItemGroup>

	<ItemGroup>
		<PackageReference Include="CommunityToolkit.Maui" Version="15.0.1" />
		<PackageReference Include="CommunityToolkit.Mvvm" Version="8.4.2" />
		<PackageReference Include="Microsoft.Maui.Controls" Version="10.0.101" />
		<PackageReference Include="Microsoft.Extensions.Logging.Debug" Version="10.0.11" />
	</ItemGroup>

</Project>
