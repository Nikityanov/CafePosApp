<?xml version="1.0" encoding="UTF-8" ?>
<ResourceDictionary 
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml">

    <!-- ═══════════════════════════════════════════ -->
    <!--  PRIMARY BRAND                              -->
    <!-- ═══════════════════════════════════════════ -->
    <Color x:Key="Primary">#512BD4</Color>
    <Color x:Key="PrimaryDark">#ac99ea</Color>
    <Color x:Key="PrimaryDarkText">#242424</Color>
    <Color x:Key="Secondary">#DFD8F7</Color>
    <Color x:Key="SecondaryDarkText">#9880e5</Color>
    <Color x:Key="Tertiary">#2B0B98</Color>

    <!-- ═══════════════════════════════════════════ -->
    <!--  SEMANTIC / STATUS COLORS                   -->
    <!--  WCAG AA wants 4.5:1 on body text and 3:1 -->
    <!--  on text at/over 18pt (or 14pt bold). Every -->
    <!--  ratio in the comments below was computed   -->
    <!--  with the WCAG 2.1 relative-luminance       -->
    <!--  formula, so the next reader can re-check   -->
    <!--  it rather than take it on trust.           -->
    <!-- ═══════════════════════════════════════════ -->
    <Color x:Key="Success">#2E7D32</Color>
    <Color x:Key="SuccessLight">#E8F5E9</Color>
    <Color x:Key="Warning">#ED6C02</Color>
    <Color x:Key="WarningLight">#FFF3E0</Color>
    <Color x:Key="Danger">#D32F2F</Color>
    <Color x:Key="DangerLight">#FFEBEE</Color>
    <Color x:Key="Info">#1976D2</Color>
    <Color x:Key="InfoLight">#E3F2FD</Color>

    <!-- ═══════════════════════════════════════════════════════════ -->
    <!--  SEMANTIC FOREGROUNDS — DARK THEME                        -->
    <!--                                                            -->
    <!--  These did not exist. Every dark-theme pairing was        -->
    <!--  improvised at the call site, and four of them kept the   -->
    <!--  LIGHT tone in the dark branch while the fill underneath  -->
    <!--  flipped to Gray700 — so the pair stopped being a pair and -->
    <!--  "Восстановить из копии…" rendered Danger #D32F2F on      -->
    <!--  Gray700 #616161, 1.24:1. Same-value theme bindings are    -->
    <!--  the signature of a missing dark token, not of an         -->
    <!--  intentional constant.                                    -->
    <!--                                                            -->
    <!--  Rule for picking one: same hue as the light token, and   -->
    <!--  the lightest tone of it that still clears 4.5:1 on       -->
    <!--  Gray800 #424242 — the dark tonal fill the danger, warning -->
    <!--  and info controls use (see Styles.xaml). Gray700 #616161  -->
    <!--  cannot carry ANY of these hues: the most saturated red   -->
    <!--  that reaches 4.5:1 on it is #FFD1D1 and the most         -->
    <!--  saturated green is #00FF08, a pale pink and a neon. That -->
    <!--  is why the fill moved rather than the value being        -->
    <!--  shipped low-contrast.                                    -->
    <!--                                                            -->
    <!--  Measured:                    Gray800  SurfaceDark  SurfVarDark -->
    <!--  DangerDark  #FF9E8E            5.04:1     8.36:1       6.91:1 -->
    <!--  WarningDark #FFB74D            5.81:1     9.63:1       7.96:1 -->
    <!--  SuccessDark #81C784            4.99:1     8.28:1       6.84:1 -->
    <!--  InfoDark    #90CAF9            5.74:1     9.53:1       7.87:1 -->
    <!--                                                            -->
    <!--  For reference, the light tokens on the fill they sit on   -->
    <!--  in DARK mode (Gray700, the old fill) were all hopeless:   -->
    <!--  Danger 1.24:1, Warning 1.99:1, Success 1.21:1, Info      -->
    <!--  1.35:1 — no dark pairing in the app cleared 4.5:1.       -->
    <!-- ═══════════════════════════════════════════════════════════ -->
    <Color x:Key="DangerDark">#FF9E8E</Color>
    <Color x:Key="WarningDark">#FFB74D</Color>
    <Color x:Key="SuccessDark">#81C784</Color>
    <Color x:Key="InfoDark">#90CAF9</Color>

    <!-- ═══════════════════════════════════════════════════════════════ -->
    <!--  SEMANTIC FOREGROUND — LIGHT THEME, WARNING                   -->
    <!--                                                            -->
    <!--  The light-theme counterpart of WarningDark, and the first   -->
    <!--  warm token in this palette that can carry TEXT at all.     -->
    <!--                                                            -->
    <!--  WHY IT HAD TO EXIST                                        -->
    <!--  ====================                                       -->
    <!--  Warning #ED6C02 has relative luminance 0.2873, so on the   -->
    <!--  lightest background the app has (Surface #FFFFFF, L=1.0)   -->
    <!--  it reaches 3.11:1, and on BackgroundLight #FAFAFA only    -->
    <!--  2.98:1. Every label between 11pt and 14pt owes 4.5:1, so   -->
    <!--  Warning could never be a light-theme foreground — at best  -->
    <!--  an 18pt+ mark, or a fill. WarningDark is not the answer:   -->
    <!--  it is the fix for a DARK fill and reaches 1.73:1 on white.  -->
    <!--  Three styles and one popup were written around that gap     -->
    <!--  instead — the long comments on TagTextWarning and          -->
    <!--  WarningToolbarButton in Styles.xaml, and on ChangeLabel in  -->
    <!--  Views/PaymentSheetPopup.xaml.                              -->
    <!--                                                            -->
    <!--  Measured, on the four backgrounds a warning-toned label     -->
    <!--  actually sits on in this app (same WCAG 2.1 relative-      -->
    <!--  luminance formula as the table above, so it can be re-run):  -->
    <!--                                                            -->
    <!--                              SurfaceDark  BackgroundLight      -->
    <!--  WarningText #A35B00           3.22:1          —                   -->
    <!--                                                            -->
    <!--                        Surface  SurfaceVariant  WarningLight -->
    <!--  WarningText #A35B00         5.18:1         4.75:1        4.72:1 -->
    <!--                                                            -->
    <!--  NOTE THE FIRST ROW. On the dark side of the app this token -->
    <!--  is 1.94:1 on Gray800 and 2.66:1 on SurfaceVariantDark, so  -->
    <!--  it is NOT a dark-theme value and must never be the dark     -->
    <!--  branch of a theme binding. Wherever this token is used, the  -->
    <!--  dark branch of the pair stays WarningDark.                  -->
    <!--                                                            -->
    <!--  WHY THIS VALUE                                             -->
    <!--  =============                                             -->
    <!--  It has to read as amber rather than as brown, and the       -->
    <!--  constraint is brutal: Material's amber ramp cannot reach    -->
    <!--  4.5:1 on white at any tone — Amber 800 #FF6F00 is 2.79:1   -->
    <!--  and Amber A700 #FFAB00 is 1.90:1 — so this token has to    -->
    <!--  leave the ramp entirely rather than pick its darkest step.  -->
    <!--                                                            -->
    <!--  Hue 33.5deg, saturation 100%, lightness 32%: the hue sits   -->
    <!--  between Warning (27.1deg) and WarningDark (35.7deg), so it -->
    <!--  reads as the warning hue darkened rather than as a         -->
    <!--  different colour, and at 100% saturation it cannot drift    -->
    <!--  toward brown the way a desaturated orange does.             -->
    <!--                                                            -->
    <!--  Rejected, with the numbers that ruled each one out:        -->
    <!--                                                            -->
    <!--    #B45309 — the value everyone reaches for first            -->
    <!--      (Tailwind amber-700). 5.02:1 on Surface, 4.81:1 on     -->
    <!--      BackgroundLight, 4.58:1 on WarningLight. It passes, but -->
    <!--      it clears the WarningLight fill by 0.08:1 — no room for -->
    <!--      a rounding difference — and at hue 26.0deg with a blue  -->
    <!--      channel of 9 it skews olive-brown.                      -->
    <!--                                                            -->
    <!--    #DD2C00 — Material deep-orange 900, the darkest warm tone -->
    <!--      Material does offer. 4.74:1 / 4.54:1 / 4.32:1, so it  -->
    <!--      fails on WarningLight, and at hue 9deg it is red, which -->
    <!--      is Danger's job (Danger #D32F2F already owns it).       -->
    <!--                                                            -->
    <!--    #A0522D — "sienna". 5.62:1 / 5.38:1 / 5.12:1, which clears -->
    <!--      everything, but its saturation is 56%. A desaturated    -->
    <!--      orange IS brown; that is the whole reason it was       -->
    <!--      rejected rather than credited for its contrast.         -->
    <!--                                                            -->
    <!--    #6E4200 — 8.60:1 on Surface. The extra contrast is not   -->
    <!--      free: at lightness 22% this is a brown-black, and a    -->
    <!--      warning the eye cannot tell from the body text beside   -->
    <!--      it has stopped being a warning.                         -->
    <!--                                                            -->
    <!--  HOW IT IS USED                                             -->
    <!--  =============                                             -->
    <!--  As the LIGHT branch wherever warning-toned TEXT is wanted, -->
    <!--  so a pair reads ThemeColors.Resolve("WarningText",          -->
    <!--  "WarningDark") — and as {AppThemeBinding Light={StaticResource-->
    <!--  WarningText}, Dark={StaticResource WarningDark}} on an      -->
    <!--  attribute.                                                  -->
    <!--                                                            -->
    <!--  It is NOT a replacement for Warning as a FILL. TagWarning   -->
    <!--  and WarningToolbarButton deliberately carry a saturated     -->
    <!--  Warning fill with Gray900 #212121 on top, 5.17:1 — the only -->
    <!--  pairing that works. WarningText on that same fill is 1.66:1 -->
    <!--  and on the Gray800 dark fill 1.94:1, so the fills stay     -->
    <!--  Warning and the ink on them stays Gray900 / WarningDark.    -->
    <!--                                                            -->
    <!--  Nothing here signals a state by colour alone: every call   -->
    <!--  site pairs the tint with wording («Сдача», «Нет в          -->
    <!--  наличии», «! Низкий остаток…»), which is why the token can -->
    <!--  change without any wording changing.                        -->
    <Color x:Key="WarningText">#A35B00</Color>

    <!-- ═══════════════════════════════════════════ -->
    <!--  SURFACE / BACKGROUND                       -->
    <!-- ═══════════════════════════════════════════ -->
    <Color x:Key="Surface">#FFFFFF</Color>
    <Color x:Key="SurfaceDark">#1E1E1E</Color>
    <Color x:Key="SurfaceVariant">#F5F5F5</Color>
    <Color x:Key="SurfaceVariantDark">#2D2D2D</Color>
    <Color x:Key="BackgroundLight">#FAFAFA</Color>
    <Color x:Key="BackgroundDark">#121212</Color>

    <!-- ═══════════════════════════════════════════ -->
    <!--  CATEGORY PALETTE (pastel, for visual coding)-->
    <!-- ═══════════════════════════════════════════ -->
    <Color x:Key="Category1">#E3F2FD</Color>  <!-- Blue -->
    <Color x:Key="Category2">#E8F5E9</Color>  <!-- Green -->
    <Color x:Key="Category3">#FFF3E0</Color>  <!-- Orange -->
    <Color x:Key="Category4">#F3E5F5</Color>  <!-- Purple -->
    <Color x:Key="Category5">#FFEBEE</Color>  <!-- Red -->
    <Color x:Key="Category6">#E0F7FA</Color>  <!-- Cyan -->
    <Color x:Key="Category7">#FFF8E1</Color>  <!-- Amber -->
    <Color x:Key="Category8">#E8EAF6</Color>  <!-- Indigo -->

    <!-- The "Комбо" filter chip. NOT a ninth category pastel: a bundle is not a section and
         borrows no CategoryId, it is the other KIND of thing on this page. It lives here so the
         chip has a real token to read instead of a literal in C#, which AppThemeBinding would
         never reach. Placed between Category4 and Category8 in tone. -->
    <Color x:Key="Combo">#EDE7F6</Color>

    <!-- ═══════════════════════════════════════════ -->
    <!--  BASIC COLORS                               -->
    <!-- ═══════════════════════════════════════════ -->
    <Color x:Key="White">White</Color>
    <Color x:Key="Black">Black</Color>
    <Color x:Key="Magenta">#D600AA</Color>
    <Color x:Key="MidnightBlue">#190649</Color>
    <Color x:Key="OffBlack">#1f1f1f</Color>

    <!-- ═══════════════════════════════════════════ -->
    <!--  GRAY SCALE                                -->
    <!-- ═══════════════════════════════════════════ -->
    <Color x:Key="Gray50">#FAFAFA</Color>
    <Color x:Key="Gray100">#F5F5F5</Color>
    <Color x:Key="Gray200">#EEEEEE</Color>
    <Color x:Key="Gray300">#E0E0E0</Color>
    <Color x:Key="Gray400">#BDBDBD</Color>
    <Color x:Key="Gray500">#9E9E9E</Color>
    <Color x:Key="Gray600">#757575</Color>
    <Color x:Key="Gray700">#616161</Color>
    <Color x:Key="Gray800">#424242</Color>
    <Color x:Key="Gray900">#212121</Color>
    <Color x:Key="Gray950">#141414</Color>

    <!-- ═══════════════════════════════════════════ -->
    <!--  STATE LAYERS                              -->
    <!--  A translucent scrim drawn over a filled    -->
    <!--  control to signal press / hover. Material   -->
    <!--  3 uses 8% hover and 12% pressed, in the     -->
    <!--  "on" colour of whatever is underneath —     -->
    <!--  so the pair flips with the theme, because   -->
    <!--  the FAB's fill does (Primary in light,      -->
    <!--  PrimaryDark in dark). One white scrim would -->
    <!--  be invisible on the light dark-mode fill.   -->
    <!-- ═══════════════════════════════════════════ -->
    <Color x:Key="StateLayerLightHover">#14FFFFFF</Color>
    <Color x:Key="StateLayerLightPressed">#1FFFFFFF</Color>
    <Color x:Key="StateLayerDarkHover">#14000000</Color>
    <Color x:Key="StateLayerDarkPressed">#1F000000</Color>

    <!-- ═══════════════════════════════════════════ -->
    <!--  BRUSHES                                   -->
    <!-- ═══════════════════════════════════════════ -->
    <SolidColorBrush x:Key="PrimaryBrush" Color="{StaticResource Primary}"/>
    <SolidColorBrush x:Key="SecondaryBrush" Color="{StaticResource Secondary}"/>
    <SolidColorBrush x:Key="TertiaryBrush" Color="{StaticResource Tertiary}"/>
    <SolidColorBrush x:Key="WhiteBrush" Color="{StaticResource White}"/>
    <SolidColorBrush x:Key="BlackBrush" Color="{StaticResource Black}"/>
    <SolidColorBrush x:Key="SuccessBrush" Color="{StaticResource Success}"/>
    <SolidColorBrush x:Key="WarningBrush" Color="{StaticResource Warning}"/>
    <SolidColorBrush x:Key="DangerBrush" Color="{StaticResource Danger}"/>
    <SolidColorBrush x:Key="InfoBrush" Color="{StaticResource Info}"/>

    <SolidColorBrush x:Key="Gray100Brush" Color="{StaticResource Gray100}"/>
    <SolidColorBrush x:Key="Gray200Brush" Color="{StaticResource Gray200}"/>
    <SolidColorBrush x:Key="Gray300Brush" Color="{StaticResource Gray300}"/>
    <SolidColorBrush x:Key="Gray400Brush" Color="{StaticResource Gray400}"/>
    <SolidColorBrush x:Key="Gray500Brush" Color="{StaticResource Gray500}"/>
    <SolidColorBrush x:Key="Gray600Brush" Color="{StaticResource Gray600}"/>
    <SolidColorBrush x:Key="Gray900Brush" Color="{StaticResource Gray900}"/>
    <SolidColorBrush x:Key="Gray950Brush" Color="{StaticResource Gray950}"/>
</ResourceDictionary>
